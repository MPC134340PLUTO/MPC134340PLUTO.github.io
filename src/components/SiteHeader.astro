---
import { destinations, activities, isCurrent, isSection } from '../data/navigation';
const current = Astro.url.pathname;
const home = destinations[0];
const nodes = destinations.slice(1);
const quick = [home, destinations[1], destinations[3], destinations[7], activities[0], ...activities.slice(3)];
---
<header class="site-header">
  <div class="header-inner">
    <a class="site-logo" href="/" aria-label="返回首页">
      <span class="logo-mark" aria-hidden="true">✦</span><span class="logo-copy"><strong>像素宇宙</strong><small lang="en">PIXEL UNIVERSE</small></span>
    </a>
    <nav class="quick-nav" aria-label="常用导航">
      {quick.map(link => <a href={link.href} class:list={{active:isCurrent(current,link.href)}} aria-current={isCurrent(current,link.href)?'page':undefined}>{link.name}</a>)}
    </nav>
    <details class="orbit-navigation" data-orbit-navigation>
      <summary class="orbit-toggle" aria-label="星轨导航：展开全站目的地">
        <span class="toggle-orbit" aria-hidden="true"><svg viewBox="0 0 40 40" width="36" height="36" fill="none"><path d="M12 3H28L37 12V28L28 37H12L3 28V12Z" stroke="currentColor" stroke-width="1.5"/><ellipse cx="20" cy="20" rx="14" ry="7" transform="rotate(-35 20 20)" stroke="currentColor" stroke-width="1.5"/><ellipse cx="20" cy="20" rx="14" ry="7" transform="rotate(35 20 20)" stroke="#b09be7" stroke-width="1.5"/><path d="M20 13L27 20L20 27L13 20Z" fill="#b4e8f4"/><path d="M32 8h3v3h-3zM6 28h3v3H6z" fill="currentColor"/></svg></span>
        <span class="toggle-copy"><strong>星轨导航</strong><small lang="en">EXPLORE ALL</small></span><span class="toggle-chevron" aria-hidden="true">⌄</span>
      </summary>
      <div class="orbit-panel">
        <div class="orbit-heading"><div><h2>选择探索目的地</h2><p>ORBITAL NAVIGATION</p></div><div class="orbit-panel-links"><a href="/galaxy/" class="full-map">星系图谱 ↗</a><a href="/explore/" class="full-map">全部目的地 ↗</a></div></div>
        <nav class="orbit-map" aria-label="星轨栏目导航">
          <svg class="orbital-lines" viewBox="0 0 760 380" preserveAspectRatio="none" aria-hidden="true"><ellipse cx="380" cy="190" rx="282" ry="130" fill="none" stroke="#83ced2" stroke-opacity=".35"/><ellipse cx="380" cy="190" rx="320" ry="112" transform="rotate(-12 380 190)" fill="none" stroke="#a18bdc" stroke-opacity=".35" stroke-dasharray="5 5"/></svg>
          <a href="/" class:list={['orbit-home',{active:isCurrent(current,'/')}]} aria-current={isCurrent(current,'/')?'page':undefined}><span aria-hidden="true">✦</span><strong>首页</strong><small lang="en">HOME</small></a>
          {nodes.map((link,i)=> <a href={link.href} class:list={['orbit-node',{active:isSection(current,link.href)}]} style={`--x:${50+37*Math.cos(-Math.PI/2+i*2*Math.PI/nodes.length)}%;--y:${50+34*Math.sin(-Math.PI/2+i*2*Math.PI/nodes.length)}%`} aria-current={isCurrent(current,link.href)?'page':undefined}><img src={link.image} alt=""/><span class="node-copy"><strong>{link.name}</strong><small lang="en">{link.en}</small></span></a>)}
        </nav>
        <nav class="activity-links" aria-label="功能入口">{activities.map(link=><a href={link.href} aria-current={isCurrent(current,link.href)?'page':undefined}><strong>{link.name} ↗</strong><small>{link.description}</small></a>)}</nav>
      </div>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-orbit-navigation]');
  document.addEventListener('click', event => { if(menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open=false; });
  document.addEventListener('keydown', event => { if(event.key==='Escape' && !event.defaultPrevented && menu?.open){menu.open=false;menu.querySelector('summary')?.focus();} });
</script>
<style>
  .site-header{position:sticky;top:0;z-index:100;background:#0b1428f7;border-bottom:1px solid #344967;backdrop-filter:blur(14px);}
  .header-inner{width:min(1500px,94%);margin:auto;min-height:80px;display:flex;align-items:center;justify-content:space-between;gap:24px;position:relative;}
  .site-logo{display:flex;align-items:center;gap:12px;flex-shrink:0;color:var(--text);text-decoration:none;}
  .logo-mark{font-size:30px;color:#a18bdc;}.logo-copy,.toggle-copy,.node-copy{display:flex;flex-direction:column;gap:2px;}.logo-copy strong{font-size:22px;}.logo-copy small,.toggle-copy small,.node-copy small,.orbit-home small{color:var(--cyan);font-family:var(--font-pixel-en,monospace);font-size:14px;letter-spacing:1px;}
  .quick-nav{display:flex;align-items:center;flex-wrap:wrap;justify-content:center;gap:8px clamp(10px,1.1vw,18px);min-width:0;}.quick-nav a{color:var(--muted);font-size:15px;white-space:nowrap;padding:9px 1px;border-bottom:2px solid transparent;}.quick-nav a:hover,.quick-nav a.active{color:var(--cyan);border-bottom-color:var(--cyan);}
  .orbit-navigation{flex-shrink:0;}.orbit-toggle{cursor:pointer;list-style:none;display:flex;align-items:center;gap:12px;min-height:60px;padding:8px 15px;background:#82d9ea;color:#edf5ff;position:relative;isolation:isolate;clip-path:polygon(12px 0,calc(100% - 12px) 0,100% 12px,100% calc(100% - 12px),calc(100% - 12px) 100%,12px 100%,0 calc(100% - 12px),0 12px);}.orbit-toggle::before{content:"";position:absolute;inset:2px;z-index:-1;clip-path:inherit;background:linear-gradient(130deg,#28495e,#182a43 65%,#1e2540);}.orbit-toggle::after{content:"";position:absolute;bottom:2px;left:30%;right:30%;height:2px;background:#b4efff;pointer-events:none;}.orbit-toggle::-webkit-details-marker{display:none;}.orbit-toggle strong{font-size:20px;letter-spacing:.055em;line-height:1.25;white-space:nowrap;}.orbit-toggle:hover::before,.orbit-navigation[open] .orbit-toggle::before{background:linear-gradient(130deg,#35657a,#243b55);}.orbit-toggle:focus-visible::before{inset:4px;}.toggle-chevron{color:#b4efff;font-size:24px;line-height:1;}.orbit-navigation[open] .toggle-chevron{transform:rotate(180deg);}
  .toggle-orbit{display:grid;place-items:center;width:36px;height:36px;flex:0 0 36px;color:#a1e5f2;}.toggle-copy small{color:#b2e3eb;white-space:nowrap;}
  .orbit-panel{position:absolute;top:calc(100% + 8px);right:0;width:min(920px,100%);max-height:calc(100dvh - 100px);overflow:auto;padding:24px 30px;background:linear-gradient(140deg,#0b1428fc,#121d35fd);border:1px solid #53778b;box-shadow:0 20px 60px #0009;}.orbit-panel:before{content:"";position:absolute;top:0;right:0;width:70px;height:3px;background:#82d9ea;pointer-events:none;}
  .orbit-heading{display:flex;justify-content:space-between;align-items:center;gap:15px;padding-bottom:14px;border-bottom:1px solid #344967;}.orbit-heading h2{font-size:23px;margin:0;}.orbit-heading p{color:var(--cyan);font:15px var(--font-pixel-en,monospace);margin:5px 0 0;}.orbit-panel-links{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;}.full-map{display:inline-flex;align-items:center;min-height:44px;padding:8px 12px;color:#b4edf7;background:#213950;font-size:14px;white-space:nowrap;clip-path:polygon(7px 0,100% 0,100% calc(100% - 7px),calc(100% - 7px) 100%,0 100%,0 7px);}.full-map:hover,.full-map:focus-visible{background:#356078;color:white;}
  .orbit-map{height:410px;position:relative;isolation:isolate;}.orbital-lines{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}.orbit-node,.orbit-home{position:absolute;left:var(--x,50%);top:var(--y,50%);transform:translate(-50%,-50%);display:flex;align-items:center;flex-direction:column;gap:5px;text-align:center;color:var(--text);width:132px;text-decoration:none;padding:6px;}.orbit-node img{width:48px;height:42px;object-fit:contain;image-rendering:pixelated;filter:drop-shadow(0 0 8px #8271b575);}.orbit-node strong,.orbit-home strong{font-size:17px;}.orbit-node:hover,.orbit-node.active,.orbit-home.active{color:var(--cyan);}.orbit-node:hover img,.orbit-node.active img{filter:drop-shadow(0 0 13px #83ced2);}.orbit-home{width:116px;height:116px;justify-content:center;border:1px solid #a18bdc;border-radius:50%;background:radial-gradient(#423a68,#111e35);}.orbit-home.active{border-color:var(--cyan);}.orbit-home>span{font-size:28px;color:var(--cyan);}
  .activity-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;border-top:1px solid #344967;padding-top:18px;}.activity-links a{display:grid;gap:5px;padding:8px 0;color:var(--cyan);}.activity-links strong{font-size:16px;}.activity-links small{color:var(--muted);font-size:13px;}.activity-links a:hover strong{text-decoration:underline;}
  a:focus-visible,summary:focus-visible{outline:2px solid var(--cyan);outline-offset:4px;}
  @media(max-width:1150px){.header-inner{flex-wrap:wrap;gap:0 10px;padding:10px 0 6px;}.quick-nav{order:3;flex-basis:100%;flex-wrap:nowrap;justify-content:flex-start;overflow-x:auto;gap:20px;padding:4px 0;}.quick-nav a{font-size:14px;padding:5px 0;}.orbit-toggle{min-height:49px;padding:6px 11px;gap:8px;}.orbit-toggle strong{font-size:16px;}.toggle-orbit{width:30px;height:30px;flex-basis:30px;}.toggle-orbit svg{width:30px;height:30px;}.orbit-panel{max-height:calc(100dvh - 140px);width:100%;padding:16px;}.orbit-map{height:350px;}.logo-copy strong{font-size:18px;}}
  @media(max-width:600px){.orbit-map{height:auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:16px 0;}.orbital-lines{display:none;}.orbit-node,.orbit-home{position:static;transform:none;width:100%;min-height:70px;height:auto;display:flex;flex-direction:row;justify-content:flex-start;text-align:left;gap:12px;border:0;background:none;padding:6px 3px;}.orbit-home>span{width:48px;text-align:center;}.orbit-node img{width:42px;height:42px;}.orbit-node strong,.orbit-home strong{font-size:15px;}.node-copy small,.orbit-home small{font-size:12px;}.activity-links{grid-template-columns:1fr;gap:4px;}.orbit-heading{flex-wrap:wrap;}.orbit-heading h2{font-size:18px;}.full-map{font-size:13px;}.logo-mark{font-size:24px;}.toggle-orbit{width:26px;height:26px;flex-basis:26px;}.toggle-orbit svg{width:26px;height:26px;}.toggle-copy small{font-size:11px;}.orbit-toggle{gap:6px;padding:6px 9px;}.toggle-chevron{font-size:18px;}}
  @media(max-width:360px){.logo-copy small,.toggle-copy small{font-size:10px;}.logo-mark{font-size:19px;}.site-logo{gap:6px;}.logo-copy strong{font-size:17px;}.orbit-panel{padding:12px;}.orbit-map{grid-template-columns:1fr;}.orbit-toggle strong{font-size:15px;}.toggle-orbit{width:22px;height:22px;flex-basis:22px;}.toggle-orbit svg{width:22px;height:22px;}.orbit-toggle{gap:5px;}}
</style>
