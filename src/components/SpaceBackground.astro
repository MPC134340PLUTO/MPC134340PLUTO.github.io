---
const {
  usePlanet = false
} = Astro.props;
---

<div class="space-scene" aria-hidden="true">
  <div class="universe-image"></div>

  {usePlanet && (
    <img
      class="planet"
      src="/media/images/planets/solar-system-static/pluto-rotation.png"
      alt=""
    />
  )}

  <div class="space-overlay"></div>
</div>

<style>
  .space-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background: #03030b;
    z-index: 0;
  }

  .universe-image {
    position: absolute;
    inset: 0;
    background-image: url('/media/images/universe.jpg');
    background-size: cover;
    background-position: center;
  }

  .planet {
    position: absolute;
    width: clamp(180px, 26vw, 360px);
    right: 10%;
    top: 22%;
    image-rendering: pixelated;
    filter: drop-shadow(0 0 32px rgba(145, 130, 255, 0.3));
  }

  .space-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(3, 3, 11, 0.82), rgba(3, 3, 11, 0.12)),
      linear-gradient(to bottom, transparent 55%, #03030b 100%);
  }

  @media (max-width: 700px) {
    .planet { width: 190px; right: -25px; top: 16%; opacity: .7; }
    .universe-image { background-position: 65% center; }
  }
</style>
