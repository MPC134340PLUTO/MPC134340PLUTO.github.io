
---
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

import '../styles/global.css';
import { getPageBackground } from '../data/pageBackgrounds';
const backdrop = getPageBackground(Astro.url.pathname);

const {
  title = 'Pixel Universe',
  description = 'A little corner of the cosmos.'
} = Astro.props;
---

<Layout
  title={title}
  description={description}
>
  <div class="site-shell">

    <SiteHeader />

    <main id="main-content" class:list={{'has-page-backdrop': Boolean(backdrop)}} style={backdrop ? `--page-image:url('${backdrop.src}');--page-position:${backdrop.position};--page-strength:${backdrop.strength}` : undefined}>
      <slot />
    </main>

    <SiteFooter />

  </div>
</Layout>
