---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import GalaxyMap from '../../components/GalaxyMap.astro';
import MotionControl from '../../components/MotionControl.astro';

const rotation = (src: string) => src.replace('/images/planet-previews/', '/gifs/planets/anto80/').replace(/\.png$/, '.gif');

const galaxies = [
  { name: '螺旋星系', en: 'SPIRAL GALAXY', src: '/media/images/galaxies/galaxy1.png', note: '旋臂向外延伸，像一座缓慢旋转的星之岛屿。' },
  { name: '远距星系', en: 'DISTANT GALAXY', src: '/media/images/galaxies/galaxy2.png', note: '在深空背景中寻找遥远星系的微弱光芒。' },
  { name: '星系核心', en: 'GALACTIC CORE', src: '/media/images/galaxies/galaxy3.png', note: '明亮的核心与旋臂构成独特的宇宙结构。' },
  { name: '蓝色星系', en: 'BLUE GALAXY', src: '/media/images/galaxies/galaxy4.png', note: '蓝色旋臂构成的星系插画。' },
];

const nebulae = [
  { name: '翡翠云雾', en: 'EMERALD CLOUD', src: '/media/images/backgrounds/nebulae/Space001.png' },
  { name: '暗夜星云', en: 'DARK NEBULA', src: '/media/images/backgrounds/nebulae/Space002.png' },
  { name: '紫色星尘', en: 'VIOLET DUST', src: '/media/images/backgrounds/nebulae/Space003.png' },
  { name: '玫瑰星云', en: 'ROSE NEBULA', src: '/media/images/backgrounds/nebulae/Space004.png' },
  { name: '青紫星云', en: 'CYAN NEBULA', src: '/media/images/backgrounds/nebulae/Space005.png' },
];

const genericWorlds = Array.from({ length: 10 }, (_, index) => ({
  name: `幻想星球 ${String(index).padStart(2, '0')}`,
  en: `PLANET SAMPLE ${String(index).padStart(2, '0')}`,
  src: `/media/images/planets/kenney-generic/planet${String(index).padStart(2, '0')}.png`,
}));

const signalWorlds = [
  { name: '海蓝星球', en: 'OCEAN SIGNAL', src: '/media/images/planet-previews/earth-rotation.png' },
  { name: '铜金星球', en: 'COPPER SIGNAL', src: '/media/images/planet-previews/gasplacid_copperclay-rotation.png' },
  { name: '灰岩星球', en: 'STONE SIGNAL', src: '/media/images/planet-previews/mercury-rotation.png' },
  { name: '深蓝星球', en: 'DEEP BLUE SIGNAL', src: '/media/images/planet-previews/neptune-rotation.png' },
  { name: '青灰星球', en: 'CYAN SIGNAL', src: '/media/images/planet-previews/swarmthick_grayblue-rotation.png' },
];
---

<SiteLayout
  title="星系探索 | Galaxy"
  description="浏览星系、星云与未知星体，探索像素宇宙中的深空图谱。"
>
  <section class="page-container galaxy-page">
    <PageIntro
      eyebrow="01 / GALAXY EXPLORATION"
      title="星系图谱"
      description="探索星系形态、星云色彩与想象中的星球。以下为宇宙主题插画与像素艺术。"
    />

    <section class="galaxy-hero">
      <img
        class="galaxy-hero-image"
        src="/media/images/backgrounds/scenes/Scene-3.jpg"
        alt="紫色星云与行星构成的深空景观"
        loading="eager"
      />
      <div class="galaxy-hero-shade"></div>
      <div class="galaxy-hero-copy">
        <span class="section-label">DEEP SPACE / SECTOR 134340</span>
        <h2>在星海之间，<br /><em>寻找新的坐标。</em></h2>
        <p>在星系与星云之间，发现不同的宇宙形态。</p>
        <a href="#star-map" class="text-link">进入星际地图 <span>↘</span></a>
        <p class="galaxy-direct"><a href="/hangar/">星际机库 ↗</a> · <a href="/hangar/voyage/">航行训练 ↗</a> · <a href="/explore/">全站探索 ↗</a></p>
      </div>
    </section>

    <section class="galaxy-section" id="star-map">
      <div class="section-heading"><div><span class="section-label">STAR MAP</span><h2>星际地图</h2></div></div>
      <p class="map-note">选择星体，前往下一站。</p>
      <GalaxyMap />
      <p><a class="text-link" href="/hangar/">前往星际机库 ↗</a>　<a class="text-link" href="/memories/collection/">浏览宇宙影像图鉴 ↗</a></p>
    </section>
    <section class="galaxy-section" id="galaxy-catalog">
      <div class="section-heading">
        <div>
          <span class="section-label">01 / GALAXY CATALOG</span>
          <h2>星系收藏</h2>
        </div>
        
      </div>

      <div class="galaxy-gallery">
        {galaxies.map((item, index) => (
          <figure class:list={['galaxy-figure', `galaxy-figure-${index + 1}`]}>
            <div class="galaxy-image-wrap">
              <img src={item.src} alt={item.name} loading="lazy" />
              <span class="image-index">0{index + 1}</span>
            </div>
            <figcaption>
              <div>
                <strong>{item.name}</strong>
                <small>{item.en}</small>
              </div>
              <p>{item.note}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="nebula-section">
      <div class="section-heading">
        <div>
          <span class="section-label">02 / NEBULA FIELD</span>
          <h2>星云色谱</h2>
        </div>
        
      </div>

      <div class="nebula-gallery">
        {nebulae.map((item, index) => (
          <figure class="nebula-figure">
            <img src={item.src} alt={item.name} loading="lazy" />
            <figcaption>
              <span>0{index + 1}</span>
              <div><strong>{item.name}</strong><small>{item.en}</small></div>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="world-section">
      <div class="section-heading">
        <div>
          <span class="section-label">03 / UNCHARTED WORLDS</span>
          <h2>想象中的星球</h2>
        </div>
        
      </div>
      <div class="world-strip">
        {genericWorlds.map((world) => (
          <figure class="world-sample">
            <img src={world.src} alt={world.name} loading="lazy" />
            <figcaption><strong>{world.name}</strong><small>{world.en}</small></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="signal-section">
      <div class="signal-copy">
        <span class="section-label">04 / DISTANT SIGNALS</span>
        <h2>像素星体<br /><em>五种色彩。</em></h2>
        <p>不同色彩与纹理的像素星体插画。</p>
      </div>
      <div class="signal-worlds">
        <div class="signal-motion"><MotionControl /></div>
        {signalWorlds.map((world, index) => (
          <figure>
            <img data-motion-src={rotation(world.src)} src={world.src} alt={world.name} loading="lazy" />
            <figcaption><span>0{index + 1}</span><strong>{world.name}</strong><small>{world.en}</small></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <div class="galaxy-footer">
      <span>SECTOR 134340 / 星系探索档案</span>
      <a href="/solar-system/">继续探索太阳系 <span>↗</span></a>
    </div>
  </section>
</SiteLayout>

<style>
  .galaxy-page { position: relative; isolation: isolate; }
  .galaxy-page::before { content: ""; position: absolute; z-index: -1; inset: 0; pointer-events: none; opacity: .12; background: url('/media/images/backgrounds/starfields/Parallax80.png') center 180px / 420px repeat; }
  .section-label { color: var(--cyan); font: 12px monospace; letter-spacing: 2px; }
  .section-heading { display:flex; justify-content:space-between; align-items:end; gap:18px; margin-bottom:25px; }
  .section-heading h2 { margin:8px 0 0; font-size:clamp(24px,3vw,32px); letter-spacing:1px; }
  .section-heading > p { margin:0 0 5px; color:var(--muted); font:12px monospace; letter-spacing:1px; }

  .galaxy-hero {
    position:relative; min-height:390px; display:flex; align-items:flex-end;
    overflow:hidden; isolation:isolate; padding:clamp(24px,5vw,54px);
    background:#0b1428;
  }
  .galaxy-hero-image,.galaxy-hero-shade { position:absolute; inset:0; width:100%; height:100%; }
  .galaxy-hero-image { z-index:-2; object-fit:cover; object-position:center 48%; }
  .galaxy-hero-shade { z-index:-1; background:linear-gradient(90deg,rgba(7,13,27,.88),rgba(7,13,27,.34) 65%,rgba(7,13,27,.2)),linear-gradient(0deg,rgba(7,13,27,.55),transparent 65%); }
  .galaxy-hero-copy { position:relative; z-index:2; max-width:540px; }
  .galaxy-hero-copy h2 { margin:18px 0; font-size:clamp(32px,5vw,56px); line-height:1.45; text-shadow:3px 3px 0 #30254f; }
  .galaxy-hero-copy h2 em { color:#b7a1ed; font-style:normal; }
  .galaxy-hero-copy p { max-width:460px; color:#d1d8e8; line-height:2; font-size:14px; }
  .text-link { display:inline-flex; gap:14px; align-items:center; margin-top:12px; color:var(--cyan); font-size:14px; }
  .text-link span { font-size:18px; }
  .hero-galaxy { position:absolute; right:7%; top:14%; width:clamp(130px,20vw,245px); opacity:.85; filter:drop-shadow(0 0 30px rgba(130,113,181,.4)); }
  .hero-coordinate { position:absolute; right:20px; bottom:16px; color:rgba(225,231,245,.7); font:12px monospace; letter-spacing:1px; }

  .galaxy-section,.nebula-section,.world-section,.signal-section { margin-top:72px; }
  .galaxy-gallery { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:22px; }
  .galaxy-figure { margin:0; min-width:0; }
  .galaxy-image-wrap { position:relative; overflow:hidden; background:#0c162b; }
  .galaxy-image-wrap img { width:100%; aspect-ratio:4/3; object-fit:cover; transition:transform .35s ease; }
  .galaxy-figure:hover .galaxy-image-wrap img { transform:scale(1.045); }
  .image-index { position:absolute; left:12px; top:12px; color:#e8e4ff; font:12px monospace; text-shadow:0 1px 5px #000; }
  .galaxy-figure figcaption { padding:14px 0 0; }
  .galaxy-figure figcaption div,.nebula-figure figcaption div { display:flex; flex-direction:column; gap:4px; }
  .galaxy-figure figcaption strong { font-size:15px; }
  .galaxy-figure figcaption small,.nebula-figure figcaption small { color:var(--cyan); font:12px monospace; letter-spacing:1px; }
  .galaxy-figure figcaption p { margin:8px 0 0; color:var(--muted); font-size:15px; line-height:1.85; }

  .nebula-gallery { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:12px; }
  .nebula-figure { position:relative; margin:0; overflow:hidden; }
  .nebula-figure img { width:100%; aspect-ratio:1; object-fit:cover; transition:transform .35s; }
  .nebula-figure:hover img { transform:scale(1.06); }
  .nebula-figure figcaption { position:absolute; inset:auto 0 0; display:flex; gap:10px; align-items:center; padding:24px 10px 10px; background:linear-gradient(transparent,rgba(5,10,24,.9)); }
  .nebula-figure figcaption > span { color:var(--cyan); font:12px monospace; }
  .nebula-figure figcaption strong { color:#edf1ff; font-size:14px; }
  .nebula-figure figcaption small { font-size:14px; }

  .world-strip { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:20px 12px; }
  .world-sample { margin:0; display:flex; align-items:center; gap:10px; min-width:0; padding:8px 0; border-bottom:1px solid rgba(131,206,210,.12); }
  .world-sample img { flex:0 0 54px; width:54px; height:54px; object-fit:contain; image-rendering:pixelated; filter:drop-shadow(0 0 10px rgba(130,113,181,.25)); }
  .world-sample figcaption { display:flex; flex-direction:column; gap:3px; min-width:0; }
  .world-sample strong { font-size:14px; }
  .world-sample small { color:var(--muted); font:12px monospace; }

  .signal-section { display:grid; grid-template-columns:.7fr 1.3fr; gap:32px; align-items:center; padding:30px 0; border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
  .signal-copy h2 { margin:15px 0; font-size:clamp(26px,3vw,38px); line-height:1.5; }
  .signal-copy h2 em { color:var(--nebula); font-style:normal; }
  .signal-copy p { color:var(--muted); font-size:15px; line-height:1.85; }
  .signal-worlds { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10px; }
  .signal-worlds figure { margin:0; text-align:center; }
  .signal-worlds img { width:100%; max-width:100px; margin:0 auto 8px; image-rendering:pixelated; filter:drop-shadow(0 0 12px rgba(131,206,210,.16)); }
  .signal-worlds figcaption { display:flex; flex-direction:column; gap:3px; }
  .signal-worlds figcaption span,.signal-worlds figcaption small { color:var(--muted); font:12px monospace; }
  .signal-worlds figcaption strong { font-size:14px; }

  .galaxy-footer { display:flex; justify-content:space-between; flex-wrap:wrap; gap:14px; margin-top:55px; padding-top:18px; border-top:1px solid var(--border); color:var(--muted); font:12px monospace; letter-spacing:1px; }
  .galaxy-footer a { color:var(--cyan); }

  @media(max-width:900px) {
    .galaxy-gallery { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .world-strip { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .signal-section { grid-template-columns:1fr; }
  }
  @media(max-width:600px) {
    .galaxy-hero { min-height:340px; padding:22px; }
    .hero-galaxy { right:2%; top:10%; width:130px; opacity:.45; }
    .nebula-gallery { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .galaxy-gallery { gap:24px 14px; }
    .signal-worlds { grid-template-columns:repeat(3,minmax(0,1fr)); row-gap:18px; }
    .section-heading { align-items:start; flex-direction:column; }
  }
  /* 黑底星系插画使用滤色叠加，原始文件保持不变。 */
  .galaxy-image-wrap { background: transparent; }
  .galaxy-image-wrap img { object-fit: contain; mix-blend-mode: screen; }
  .galaxy-gallery { gap: 26px; }
  .nebula-figure figcaption { padding-top: 36px; }
  .map-note { color:var(--muted); font-size:15px; }
  .signal-motion { grid-column:1 / -1; flex-basis:100%; }
  .galaxy-direct a {color:var(--cyan);font-size:15px;text-decoration:underline;text-underline-offset:4px;}
</style>
