---
import SiteLayout from '../../layouts/SiteLayout.astro';
import GalaxyAtlasV02 from '../../components/GalaxyAtlasV02.astro';
import MotionControl from '../../components/MotionControl.astro';
import '../../styles/galaxy-v02.css';
const galaxies = [
 ['螺旋星系','SPIRAL GALAXY','galaxy1.png','旋臂向外延伸，像一座缓慢旋转的星之岛屿。'],
 ['远距星系','DISTANT GALAXY','galaxy2.png','在深空背景中寻找遥远星系的微弱光芒。'],
 ['星系核心','GALACTIC CORE','galaxy3.png','明亮的核心与旋臂构成独特的宇宙结构。'],
 ['蓝色星系','BLUE GALAXY','galaxy4.png','蓝色旋臂构成的星系插画。']
];
const nebulae=['翡翠云雾','暗夜星云','紫色星尘','玫瑰星云','青紫星云'];
const nebulaEn=['EMERALD CLOUD','DARK NEBULA','VIOLET DUST','ROSE NEBULA','CYAN NEBULA'];
const worlds=Array.from({length:10},(_,i)=>String(i).padStart(2,'0'));
const signals=[['海蓝星球','OCEAN SIGNAL','earth-rotation'],['铜金星球','COPPER SIGNAL','gasplacid_copperclay-rotation'],['灰岩星球','STONE SIGNAL','mercury-rotation'],['深蓝星球','DEEP BLUE SIGNAL','neptune-rotation'],['青灰星球','CYAN SIGNAL','swarmthick_grayblue-rotation']];
---
<SiteLayout title="星系图谱 | Galaxy" description="探索 Pixel Universe 的星域、航线和宇宙主题收藏。">
 <div id="star-map"><GalaxyAtlasV02 /></div>
 <section class="pug" aria-label="原有宇宙主题收藏">
 <div class="catalog" id="galaxy-catalog"><p class="kicker">GALAXY CATALOG / 既有收藏</p><h2>星系收藏</h2><p class="muted">下列为宇宙主题插画与像素艺术，不代表真实天文比例。</p><div class="catalog-grid">{galaxies.map(([name,en,src,note])=><figure><img src={'/media/images/galaxies/'+src} alt={name} loading="lazy"/><figcaption><strong>{name}</strong><br/><small>{en}</small><p>{note}</p></figcaption></figure>)}</div>
 <h2>星云色谱</h2><div class="catalog-grid">{nebulae.map((name,i)=><figure><img src={'/media/images/backgrounds/nebulae/Space00'+(i+1)+'.png'} alt={name} loading="lazy"/><figcaption>{name}<br/><small>{nebulaEn[i]}</small></figcaption></figure>)}</div>
 <h2>想象中的星球</h2><div class="catalog-grid">{worlds.map(i=><figure><img src={'/media/images/planets/kenney-generic/planet'+i+'.png'} alt={'幻想星球 '+i} loading="lazy"/><figcaption>幻想星球 {i}<br/><small>PLANET SAMPLE {i}</small></figcaption></figure>)}</div>
 <h2>像素星体 · 五种色彩</h2><MotionControl/><div class="catalog-grid">{signals.map(([name,en,src])=><figure><img src={'/media/images/planet-previews/'+src+'.png'} data-motion-src={'/media/gifs/planets/anto80/'+src+'.gif'} alt={name} loading="lazy"/><figcaption>{name}<br/><small>{en}</small></figcaption></figure>)}</div><p style="margin-top:20px"><a href="/solar-system/">继续探索太阳系 ↗</a> · <a href="/memories/collection/">浏览宇宙影像图鉴 ↗</a></p></div></section>
</SiteLayout>
