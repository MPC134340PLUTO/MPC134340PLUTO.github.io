---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import stars from '../../data/starOracles.json';
---
<SiteLayout title="星辰来签 | Star Oracle" description="领取一颗今日恒星，一份灵感、一件小挑战和一则天文知识。"><section class="page-container oracle" data-oracle data-stars={JSON.stringify(stars)}><PageIntro eyebrow="STAR ORACLE" title="星辰来签" description="从一百颗恒星中，领取今天的一束星光。" />
<div class="oracle-stage"><div class="star-ring" aria-hidden="true"><span>✦</span></div><p class="date" data-date></p><h2 data-title>今日星光</h2><p data-en>YOUR STAR TODAY</p><button type="button" data-draw>领取今日星签</button><p class="quiet">每日一签 · 灵感娱乐</p></div>
<div data-result hidden class="oracle-result"><div><h3>今日运势</h3><p data-fortune></p></div><div><h3>今日小挑战</h3><p data-challenge></p></div><div><h3>宇宙小知识</h3><p data-fact></p><a data-source target="_blank" rel="noopener noreferrer">知识来源 ↗</a> · <a href="https://iauarchive.eso.org/public/themes/naming_stars/" target="_blank" rel="noopener noreferrer">恒星名称资料 ↗</a></div></div><a href="/explore/">← 继续探索</a></section></SiteLayout>
<script>
  type Star={id:number;name:string;cn:string;constellation:string;fortune:string;challenge:string;fact:string;source:string};
  const root=document.querySelector<HTMLElement>('[data-oracle]');
  if(root){const stars:Star[]=JSON.parse(root.dataset.stars??'[]');const button=root.querySelector<HTMLButtonElement>('[data-draw]')!;let currentDraw:{date:string;id:number}|null=null;const date=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};const text=(key:string,value:string)=>{const el=root.querySelector<HTMLElement>(`[data-${key}]`);if(el)el.textContent=value;};function display(s:Star){text('title',s.cn||s.name);text('en',`${s.name} · ${s.constellation}`);text('fortune',s.fortune);text('challenge',s.challenge);text('fact',s.fact);const a=root!.querySelector<HTMLAnchorElement>('[data-source]');if(a)a.href=s.source;root!.querySelector<HTMLElement>('[data-result]')!.hidden=false;button.textContent='今日星签已领取';button.disabled=true;} function restore(){text('date',date());try{const saved=currentDraw??JSON.parse(localStorage.getItem('pu.oracle.v1')??'null');const star=stars.find(s=>s.id===saved?.id);if(saved?.date===date()&&star){display(star);return;}}catch{}text('title','今日星光');text('en','YOUR STAR TODAY');button.disabled=false;button.textContent='领取今日星签';root!.querySelector<HTMLElement>('[data-result]')!.hidden=true;}button.addEventListener('click',()=>{const s=stars[Math.floor(Math.random()*stars.length)];currentDraw={date:date(),id:s.id};try{localStorage.setItem('pu.oracle.v1',JSON.stringify(currentDraw));}catch{}display(s);});document.addEventListener('visibilitychange',()=>{if(!document.hidden)restore();});restore();}
</script>
<style>.oracle-stage{text-align:center;padding:50px 15px;background:radial-gradient(ellipse at center,#48376560,transparent 68%)}.star-ring{width:170px;height:170px;margin:auto;display:grid;place-items:center;border:1px solid #a18bdc80;border-radius:50%;outline:1px dashed #83ced255;outline-offset:14px;box-shadow:0 0 35px #a18bdc30}.star-ring span{font-size:80px;color:#d4c4ff;text-shadow:0 0 25px #83ced2}.date,.quiet{color:var(--muted);font-size:14px}.oracle-stage h2{font-size:36px;margin:10px}.oracle-stage button{background:#7160b6;color:white;font:inherit;padding:12px 22px;border:1px solid #a18bdc;cursor:pointer}.oracle-stage button:disabled{opacity:.65}.oracle-result{margin:25px 0 40px}.oracle-result>div{padding:20px 0;border-bottom:1px solid var(--border)}.oracle-result h3{color:var(--cyan);font-size:21px}.oracle-result p{font-size:17px;line-height:1.8}.oracle-result a{color:var(--cyan)}</style>
