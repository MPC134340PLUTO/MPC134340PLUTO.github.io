---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import { fleet } from '../../../data/fleet';
---
<SiteLayout title="星际航行 | Voyage" description="驾驶飞船，守护星光核心。">
  <section class="page-container voyage" data-voyage data-fleet={JSON.stringify(fleet)}>
    <PageIntro eyebrow="FLIGHT TRAINING" title="星光守卫 · 星际航行" description="穿越陨石带，守护星光核心，迎接不断增强的波次。" />
    <div class="flight-toolbar"><span>当前飞船：<strong data-craft>{fleet[0].name}</strong></span><span>得分：<strong data-score>0</strong></span><span>剩余：<strong data-time>90</strong> 秒</span><span>波次：<strong data-wave>1</strong></span><span>护盾：<strong data-shield>3</strong>/<span data-maxshield>3</span></span><span>核心：<strong data-core>100</strong>%</span><span>等级：<strong data-level>1</strong></span><span>最高分：<strong data-best>0</strong></span></div>
    <div class="flight-stage"><canvas width="800" height="450" tabindex="0" aria-label="飞船航行训练区域。使用方向键或 WASD 操作，也可使用下方方向按钮。"></canvas></div>
    <div class="flight-actions"><button type="button" data-start>开始训练</button><button type="button" data-pause disabled>暂停</button><button type="button" data-pulse disabled>能量脉冲 · Space</button><a href="/hangar/">更换飞船 ↗</a></div>
    <p data-message role="status">点击开始训练。方向键或 WASD 移动，收集青色信标，恢复核心与护盾；靠近核心时可用飞船拦截陨石。按空格释放能量脉冲，击碎附近陨石。守住 90 秒。</p>
    <div class="direction-pad" aria-label="触屏方向控制"><button type="button" data-dir="up" aria-label="向上">↑</button><button type="button" data-dir="left" aria-label="向左">←</button><button type="button" data-dir="down" aria-label="向下">↓</button><button type="button" data-dir="right" aria-label="向右">→</button></div>
    <section class="voyage-progress"><h2>航行档案</h2><p>等级 <strong data-level-record>1</strong> · 星尘 <strong data-credits>0</strong> · 经验 <strong data-xp>0</strong></p><p data-achievements></p><a href="/hangar/#upgrade">返回机库强化飞船 ↗</a></section><nav class="flight-note"><a href="/hangar/">← 返回机库</a> · <a href="/radio/">分享航行感想 ↗</a> · <a href="/explore/">全站探索 ↗</a></nav>
  </section>
</SiteLayout>
<script>
  import {loadProgress,saveProgress,recordRun,levelOf,achievements} from "../../../data/voyageProgress";
  type Ship = { id:string; name:string; src:string; speed:number };
  type Body = {x:number;y:number;r:number;vx:number;vy:number};
  const root=document.querySelector<HTMLElement>('[data-voyage]');
  if(root){
    const canvas=root.querySelector<HTMLCanvasElement>('canvas')!;
    const ctx=canvas.getContext('2d');
    const fleet:Ship[]=JSON.parse(root.dataset.fleet??'[]');
    const start=root.querySelector<HTMLButtonElement>('[data-start]')!;
    const pause=root.querySelector<HTMLButtonElement>('[data-pause]')!;const pulseBtn=root.querySelector<HTMLButtonElement>('[data-pulse]')!;
    const message=root.querySelector<HTMLElement>('[data-message]')!;
    const text=(key:string,value:string|number)=>{const el=root.querySelector<HTMLElement>(`[data-${key}]`);if(el)el.textContent=String(value);};
    const progress=loadProgress();const maxShield=3+progress.upgrades.shield;const pulseDelay=2.2-progress.upgrades.pulse*.25;let saved='',best=progress.best;
    try{saved=localStorage.getItem('pu.ship.v1')??'';best=Math.max(best,Number(localStorage.getItem('pu.voyage.guard.best.v1'))||0);}catch{}
    const ship=fleet.find(s=>s.id===saved)??fleet[0];
    const speedBonus=1+progress.upgrades.drive*.07;function renderProgress(){text('level',levelOf(progress));text('level-record',levelOf(progress));text('credits',progress.credits);text('xp',progress.xp);text('achievements',achievements(progress).map(a=>(a.earned?'✓ ':'◇ ')+a.name).join(' · '));}text('craft',ship.name);text('best',best);text('maxshield',maxShield);text('shield',maxShield);renderProgress();
    const bg=new Image();bg.src='/media/images/backgrounds/community/voyage.webp';const sprite=new Image();sprite.src=ship.src;const rock=new Image();rock.src="/media/sprites/space-isometric/Decorations_tiles/Medium_rocks_1.png";
    const W=canvas.width,H=canvas.height;
    const keys=new Set<string>();
    const keyMap:Record<string,string>={ArrowUp:'up',ArrowDown:'down',ArrowLeft:'left',ArrowRight:'right',w:'up',a:'left',s:'down',d:'right'};
    const stars=Array.from({length:90},(_,i)=>({x:(i*137+29)%W,y:(i*73+11)%H,r:i%9===0?2:1}));
    let x=W/2,y=H/2,score=0,left=90,shield=maxShield,core=100,wave=1,invul=0,cooldown=0,flash=0,active=false,paused=false,raf=0,last=0;
    let obstacles:Body[]=[];let beacon={x:100,y:100,r:13};
    function newBeacon(){for(let i=0;i<80;i++){const b={x:35+Math.random()*(W-70),y:35+Math.random()*(H-70),r:13};if(Math.hypot(b.x-x,b.y-y)>85&&obstacles.every(o=>Math.hypot(b.x-o.x,b.y-o.y)>o.r+35)){beacon=b;return;}}}
    function draw(){if(!ctx)return;ctx.clearRect(0,0,W,H);ctx.imageSmoothingEnabled=false;ctx.fillStyle='#080f22';ctx.fillRect(0,0,W,H);if(bg.complete&&bg.naturalWidth){ctx.globalAlpha=.25;ctx.drawImage(bg,0,0,W,H);ctx.globalAlpha=1;}for(const s of stars){ctx.fillStyle=s.r===2?'#83ced2':'#6c7b9d';ctx.fillRect(s.x,s.y,s.r,s.r);}ctx.strokeStyle='#83ced2';ctx.lineWidth=2;const glow=ctx.createRadialGradient(W/2,H/2,3,W/2,H/2,55);glow.addColorStop(0,'#b5fff0');glow.addColorStop(.35,'#4bbf9a80');glow.addColorStop(1,'#4bbf9a00');ctx.fillStyle=glow;ctx.fillRect(W/2-55,H/2-55,110,110);ctx.strokeStyle='#83ced2';ctx.beginPath();ctx.arc(W/2,H/2,21,0,Math.PI*2);ctx.stroke();ctx.strokeRect(beacon.x-10,beacon.y-10,20,20);ctx.fillStyle='#83ced2';ctx.fillRect(beacon.x-4,beacon.y-4,8,8);for(const o of obstacles){if(rock.complete&&rock.naturalWidth){ctx.drawImage(rock,o.x-o.r,o.y-o.r,o.r*2,o.r*2);continue;}ctx.fillStyle='#927e76';ctx.beginPath();for(let i=0;i<8;i++){const a=i*Math.PI/4,r=o.r*(i%2===0?1:.8);const xx=o.x+Math.cos(a)*r,yy=o.y+Math.sin(a)*r;if(i===0)ctx.moveTo(xx,yy);else ctx.lineTo(xx,yy);}ctx.closePath();ctx.fill();ctx.fillStyle='#564b4e';ctx.fillRect(o.x-5,o.y-6,9,8);}if(invul>0&&Math.floor(invul*10)%2===0)ctx.globalAlpha=.45;if(sprite.complete&&sprite.naturalWidth){const w=54,h=w*sprite.naturalHeight/sprite.naturalWidth;ctx.drawImage(sprite,x-w/2,y-h/2,w,h);}else{ctx.fillStyle='#a18bdc';ctx.fillRect(x-15,y-10,30,20);}ctx.globalAlpha=1;if(flash>0){ctx.strokeStyle=`rgba(131,206,210,${flash/.35})`;ctx.lineWidth=3;ctx.beginPath();ctx.arc(x,y,115*(1-flash/.35),0,Math.PI*2);ctx.stroke();}}
    function pulse(){if(!active||paused||cooldown>0)return;cooldown=pulseDelay;flash=.35;for(let i=0;i<obstacles.length;i++){if(Math.hypot(obstacles[i].x-x,obstacles[i].y-y)<115){obstacles[i]=spawn();score+=5;}}text('score',score);}
    function stop(reason:string,won=false){if(!active)return;active=false;paused=false;cancelAnimationFrame(raf);keys.clear();pause.disabled=true;pulseBtn.disabled=true;pause.textContent='暂停';start.textContent='重新训练';if(score>best){best=score;try{localStorage.setItem('pu.voyage.guard.best.v1',String(best));}catch{}text('best',best);}const reward=recordRun(progress,score,wave,won);const savedProgress=saveProgress(progress);renderProgress();message.textContent=`${reason} 得分 ${score} · 星尘 +${reward.credits} · 经验 +${reward.xp}${savedProgress?'':'（浏览器存储不可用）'}`;}
    function spawn():Body{const side=Math.floor(Math.random()*4),r=15+Math.random()*9;const ox=side===0?r:side===1?W-r:40+Math.random()*(W-80),oy=side===2?r:side===3?H-r:40+Math.random()*(H-80);const dx=W/2-ox,dy=H/2-oy,dist=Math.hypot(dx,dy)||1;const speed=55+wave*15;return{x:ox,y:oy,r,vx:dx/dist*speed,vy:dy/dist*speed};}
    function frame(now:number){if(!active||paused)return;const dt=Math.min((now-last)/1000,.05);last=now;left=Math.max(0,left-dt);invul=Math.max(0,invul-dt);cooldown=Math.max(0,cooldown-dt);flash=Math.max(0,flash-dt);pulseBtn.disabled=cooldown>0;pulseBtn.textContent=cooldown>0?`脉冲充能 ${cooldown.toFixed(1)}s`:'能量脉冲 · Space';const nextWave=Math.min(6,1+Math.floor((90-left)/15));if(nextWave>wave){wave=nextWave;obstacles.push(spawn(),spawn());text('wave',wave);}let dx=Number(keys.has('right'))-Number(keys.has('left')),dy=Number(keys.has('down'))-Number(keys.has('up'));const mag=Math.hypot(dx,dy)||1;x=Math.max(27,Math.min(W-27,x+dx/mag*ship.speed*speedBonus*dt));y=Math.max(27,Math.min(H-27,y+dy/mag*ship.speed*speedBonus*dt));for(const o of obstacles){o.x+=o.vx*dt;o.y+=o.vy*dt;if(o.x<o.r||o.x>W-o.r){o.x=Math.max(o.r,Math.min(W-o.r,o.x));o.vx*=-1;}if(o.y<o.r||o.y>H-o.r){o.y=Math.max(o.r,Math.min(H-o.r,o.y));o.vy*=-1;}}if(Math.hypot(x-beacon.x,y-beacon.y)<30){score+=10;shield=Math.min(maxShield,shield+1);core=Math.min(100,core+10);newBeacon();}for(let i=0;i<obstacles.length;i++){const o=obstacles[i];if(Math.hypot(x-o.x,y-o.y)<o.r+17&&invul===0){shield--;invul=1.4;score+=5;obstacles[i]=spawn();continue;}if(Math.hypot(W/2-o.x,H/2-o.y)<o.r+21){core=Math.max(0,core-8);obstacles[i]=spawn();}}text('score',score);text('shield',shield);text('core',core);text('time',Math.ceil(left));draw();if(shield<=0||core<=0){stop(shield<=0?'护盾耗尽。':'星光核心失守。');return;}if(left<=0){stop('星光核心守护成功！',true);return;}raf=requestAnimationFrame(frame);}
    function setPaused(value:boolean){if(!active)return;paused=value;pulseBtn.disabled=value||cooldown>0;cancelAnimationFrame(raf);keys.clear();pause.textContent=value?'继续':'暂停';message.textContent=value?'训练已暂停。':'训练进行中。';if(!value){last=performance.now();raf=requestAnimationFrame(frame);canvas.focus();}}
    start.addEventListener('click',()=>{cancelAnimationFrame(raf);x=W/2+100;y=H/2;score=0;left=90;shield=maxShield;core=100;wave=1;invul=0;cooldown=0;flash=0;keys.clear();obstacles=Array.from({length:3},()=>spawn());newBeacon();text('score',0);text('time',90);text('shield',maxShield);text('core',100);text('wave',1);active=true;paused=false;pause.disabled=false;pulseBtn.disabled=false;pulseBtn.textContent='能量脉冲 · Space';pause.textContent='暂停';start.textContent='重新训练';message.textContent='训练进行中。';canvas.focus();last=performance.now();raf=requestAnimationFrame(frame);});
    pause.addEventListener('click',()=>setPaused(!paused));pulseBtn.addEventListener('click',()=>{pulse();canvas.focus();});
    canvas.addEventListener('keydown',e=>{if(e.code==='Space'&&active&&!paused){e.preventDefault();if(!e.repeat)pulse();return;}const dir=keyMap[e.key]??keyMap[e.key.toLowerCase()];if(dir&&active&&!paused){e.preventDefault();keys.add(dir);}});
    window.addEventListener('keyup',e=>{const dir=keyMap[e.key]??keyMap[e.key.toLowerCase()];if(dir)keys.delete(dir);});
    canvas.addEventListener('blur',()=>keys.clear());window.addEventListener('blur',()=>{if(active&&!paused)setPaused(true);});document.addEventListener('visibilitychange',()=>{if(document.hidden&&active&&!paused)setPaused(true);});
    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach(b=>{const dir=b.dataset.dir!;b.addEventListener('pointerdown',e=>{if(active&&!paused){e.preventDefault();b.setPointerCapture(e.pointerId);keys.add(dir);}});for(const event of ['pointerup','pointercancel','lostpointercapture'])b.addEventListener(event,()=>keys.delete(dir));b.addEventListener('keydown',e=>{if(e.key===' '||e.key==='Enter'){e.preventDefault();if(active&&!paused)keys.add(dir);}});b.addEventListener('keyup',()=>keys.delete(dir));b.addEventListener('blur',()=>keys.delete(dir));});
    sprite.addEventListener('load',draw);bg.addEventListener('load',draw);draw();
  }
</script>
<style>
  .flight-toolbar{display:flex;flex-wrap:wrap;gap:16px 30px;justify-content:space-between;padding:16px 0;color:var(--cyan);}.flight-toolbar strong{color:var(--text);}.flight-stage{border:1px solid var(--border);background:#080f22;}.flight-stage canvas{display:block;width:100%;height:auto;max-height:65vh;object-fit:contain;touch-action:none;}.flight-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:20px 0;}.flight-actions button,.direction-pad button{background:#172640;color:var(--text);border:1px solid var(--border);padding:10px 18px;min-height:44px;cursor:pointer;font:inherit;}.flight-actions button:first-child{background:#7160b6;border-color:#a18bdc;}.flight-actions button:disabled{opacity:.45;cursor:default;}.direction-pad{display:grid;grid-template-columns:repeat(3,52px);gap:6px;width:max-content;margin:20px auto;touch-action:none;}.direction-pad button:first-child{grid-column:2;}.direction-pad button:nth-child(2){grid-column:1;grid-row:2;}.direction-pad button:nth-child(3){grid-column:2;grid-row:2;}.direction-pad button:nth-child(4){grid-column:3;grid-row:2;}.flight-note,[data-message]{color:var(--muted);font-size:15px;line-height:1.8;}button:focus-visible,a:focus-visible,canvas:focus-visible{outline:2px solid var(--cyan);outline-offset:3px;}
.voyage-progress{margin:30px 0;padding:20px 0;border-top:1px solid var(--border)}.voyage-progress strong{color:var(--cyan)}.voyage-progress a{color:var(--cyan)}</style>
