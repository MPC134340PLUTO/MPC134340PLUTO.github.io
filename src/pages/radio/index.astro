---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { radioConfig } from '../../data/radioConfig';
---
<SiteLayout title="宇宙电台 | Cosmic Radio" description="来自遥远深空的讯息。"><section class="page-container radio" data-radio data-api={radioConfig.api} data-sitekey={radioConfig.siteKey}><PageIntro eyebrow="COSMIC RADIO" title="宇宙电台" description="来自遥远深空的讯息" />
<div class="radio-hero"><svg viewBox="0 0 240 150" width="240" aria-hidden="true"><g fill="none" stroke="#83ced2" stroke-width="1.5"><circle cx="120" cy="64" r="18"/><circle cx="120" cy="64" r="34" stroke-dasharray="4 5"/><circle cx="120" cy="64" r="50" opacity=".5"/><path d="M120 82V135M90 135H150M120 64L174 12"/></g><circle cx="120" cy="64" r="7" fill="#c8b8f4"/></svg><h2>把一束讯息发送到星海</h2><p>分享问候、灵感、网站建议，或来自另一颗星的故事。</p></div>
<div class="radio-columns"><section id="transmit"><h2>发送讯息 <small>TRANSMIT</small></h2><form data-form><label>呼号 / 昵称<input name="name" required maxlength="24" autocomplete="nickname" placeholder="你的星际呼号" /></label><label>讯息<textarea name="message" required maxlength="500" rows="6" placeholder="想对这个宇宙说些什么？"></textarea></label><label class="trap" aria-hidden="true">网站<input name="website" tabindex="-1" autocomplete="off" /></label><div data-challenge></div><p class="muted">留言经站主审核后公开。请勿填写个人隐私信息。</p><button type="submit" disabled>发送讯息</button><p role="status" data-status>电台等待连接。</p></form></section><section><h2>收到的讯息 <small>INBOX</small></h2><div data-messages aria-live="polite"><p class="muted">正在连接电台…</p></div></section></div></section></SiteLayout>
<script>
  type TS={render:(el:HTMLElement,options:{sitekey:string;callback:(t:string)=>void;'expired-callback':()=>void;'error-callback':()=>void})=>string;reset:(id:string)=>void};
  const root=document.querySelector<HTMLElement>('[data-radio]');
  if(root){const api=root.dataset.api?.replace(/\/$/,'')??'',key=root.dataset.sitekey??'';const form=root.querySelector<HTMLFormElement>('[data-form]')!,status=root.querySelector<HTMLElement>('[data-status]')!,messages=root.querySelector<HTMLElement>('[data-messages]')!,btn=form.querySelector<HTMLButtonElement>('button')!;let token='',widget='',busy=false;const getTS=()=> (window as Window & {turnstile?:TS}).turnstile;const enable=()=>{btn.disabled=busy||!token;};async function load(){if(!api){messages.textContent='电台即将开放。';return;}try{const r=await fetch(api+'/messages');if(!r.ok)throw Error();const data=await r.json() as {messages:{name:string;message:string;created_at:string}[]};messages.replaceChildren();if(!data.messages.length)messages.textContent='星海暂时安静，欢迎留下第一条讯息。';for(const m of data.messages){const article=document.createElement('article'),heading=document.createElement('h3'),body=document.createElement('p'),time=document.createElement('time');heading.textContent=m.name;body.textContent=m.message;time.textContent=m.created_at.slice(0,10);article.append(heading,body,time);messages.append(article);}}catch{messages.textContent='暂时无法接收讯息，请稍后刷新。';}}load();if(api&&key){const script=document.createElement('script');script.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';script.async=true;script.onload=()=>{const ts=getTS();if(ts)widget=ts.render(root.querySelector<HTMLElement>('[data-challenge]')!,{sitekey:key,callback:t=>{token=t;enable();},'expired-callback':()=>{token='';enable();},'error-callback':()=>{token='';enable();status.textContent='验证暂不可用，请刷新。';}});};script.onerror=()=>{status.textContent='验证服务暂不可用。';};document.head.append(script);status.textContent='请完成验证后发送。';}else status.textContent='电台服务尚未启用。';form.addEventListener('submit',async e=>{e.preventDefault();if(!token||busy||!api)return;busy=true;enable();const fd=new FormData(form);try{const r=await fetch(api+'/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:fd.get('name'),message:fd.get('message'),website:fd.get('website'),token})});if(!r.ok){status.textContent=r.status===429?'讯息发送频繁，请稍后再试。':'发送失败，请检查内容和验证。';return;}form.reset();status.textContent='讯息已发出，等待站主审核。';}catch{status.textContent='连接中断，请稍后再试。';}finally{token='';busy=false;getTS()?.reset(widget);enable();}});}
</script>
<style>.radio-hero{text-align:center;padding:30px 0 40px;background:radial-gradient(ellipse,#274b6540,transparent 65%)}.radio-hero svg{display:block;margin:auto}.radio-hero h2{font-size:clamp(23px,3vw,36px)}.radio-columns{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:50px;margin:25px 0 60px}.radio-columns h2{font-size:23px;border-bottom:1px solid var(--border);padding-bottom:15px}.radio-columns small{font:16px var(--font-pixel-en,monospace);color:var(--cyan)}.radio form{display:grid;gap:16px}.radio label{display:grid;gap:8px;color:var(--text)}.radio input,.radio textarea{font:inherit;color:var(--text);background:#111e35;border:1px solid var(--border);padding:12px;width:100%;box-sizing:border-box}.radio button{font:inherit;background:#7160b6;border:1px solid #a18bdc;color:white;padding:12px;cursor:pointer}.radio button:disabled{opacity:.5;cursor:default}.trap{position:absolute!important;left:-10000px}.muted,[data-status]{font-size:14px;color:var(--muted)}[data-messages] :global(article){padding:18px 0;border-bottom:1px solid var(--border)}[data-messages] :global(h3){color:var(--cyan);margin:0 0 8px}[data-messages] :global(p){white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8}[data-messages] :global(time){font-size:13px;color:var(--muted)}@media(max-width:760px){.radio-columns{grid-template-columns:1fr;gap:24px}}</style>
