---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { destinations, activities } from '../../data/navigation';
---
<SiteLayout title="全站探索 | Explore" description="像素宇宙的全部栏目与功能入口。">
  <section class="page-container explore-page">
    <PageIntro eyebrow="EXPLORE / PIXEL UNIVERSE" title="全站探索地图" description="选择一个目的地，或直接进入飞船航行、任务管理与影像浏览。" />
    <section class="featured-journey"><div><p class="eyebrow">HANGAR / VOYAGE</p><h2>准备出发，探索星海。</h2><p>选择一艘像素飞船，进入航行训练，收集星光信标。</p><div class="feature-actions"><a href="/hangar/">选择飞船 ↗</a><a href="/hangar/voyage/">直接开始训练 ↗</a></div></div><img src="/media/images/hangar/scout.png" alt="巡星者像素飞船" /></section>
    <section class="all-destinations"><h2>星轨目的地 <small lang="en">DESTINATIONS</small></h2><nav class="destinations" aria-label="全部栏目">{destinations.map(link=><a href={link.href}><img src={link.image} alt="" loading="lazy"/><span><strong>{link.name}</strong><small lang="en">{link.en}</small><span>{link.description}</span></span><b aria-hidden="true">↗</b></a>)}</nav></section>
    <section><h2>功能与活动 <small lang="en">ACTIVITIES</small></h2><nav class="activities" aria-label="功能页面">{activities.map(link=><a href={link.href}><img src={link.image} alt="" loading="lazy"/><span><strong>{link.name}</strong><small lang="en">{link.en}</small><span>{link.description}</span></span><b aria-hidden="true">↗</b></a>)}</nav></section>
  </section>
</SiteLayout>
<style>
.explore-page h2{font-size:clamp(24px,3vw,36px);margin:0 0 16px;}.explore-page h2 small{font:18px var(--font-pixel-en,monospace);color:var(--cyan);margin-left:10px;}.featured-journey{display:grid;grid-template-columns:minmax(0,1fr) minmax(110px,30%);gap:20px;align-items:center;padding:clamp(24px,5vw,55px);background:linear-gradient(90deg,#0b1428e8,#0b142860),url('/media/images/backgrounds/nebulae/Space003.png') center/cover;}.featured-journey p{color:var(--muted);font-size:16px;}.featured-journey img{width:100%;max-height:180px;object-fit:contain;image-rendering:pixelated;filter:drop-shadow(0 0 22px #a18bdc80);}.feature-actions{display:flex;flex-wrap:wrap;gap:12px 20px;margin-top:24px;}.feature-actions a{padding:9px 15px;color:#e6eaf4;background:#62529e;border:1px solid #a18bdc;font-size:15px;}.all-destinations,.explore-page>section:last-child{margin-top:60px;}.destinations,.activities{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:40px;}.destinations a,.activities a{display:grid;grid-template-columns:64px minmax(0,1fr) auto;gap:15px;align-items:center;padding:20px 4px;border-bottom:1px solid #344967;}.destinations img,.activities img{width:64px;height:58px;object-fit:contain;image-rendering:pixelated;}.destinations a>span,.activities a>span{display:grid;gap:3px;}.destinations strong,.activities strong{font-size:19px;}.destinations small,.activities small{font:15px var(--font-pixel-en,monospace);color:var(--cyan);}.destinations a>span>span,.activities a>span>span{font-size:14px;color:var(--muted);}.destinations b,.activities b{color:var(--cyan);}.destinations a:hover,.activities a:hover{color:var(--cyan);background:#19294460;}a:focus-visible{outline:2px solid var(--cyan);outline-offset:3px;}@media(max-width:700px){.destinations,.activities{grid-template-columns:1fr;}.featured-journey{grid-template-columns:1fr;}.featured-journey img{max-height:100px;grid-row:1;}.explore-page h2 small{display:block;margin-left:0;}}
</style>
