---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="像素宇宙 | Pixel Universe"
  description="一个记录算法竞赛、科研探索、开发项目与宇宙灵感的个人空间。A personal space for algorithms, research and projects."
>
  <section class="home-page" aria-label="像素宇宙首页">
    <div class="home-background" aria-hidden="true">
      <div class="home-bg-image" data-home-background></div>
      <div class="home-bg-grid"></div>
    </div>

    <div class="home-content">
      <section class="home-copy" aria-labelledby="home-title">
        <p class="home-eyebrow">个人空间站 <span>/</span> PERSONAL SPACE STATION <span>/</span> 134340</p>
        <p class="home-welcome">
          欢迎来到我的宇宙
          <span>WELCOME, EXPLORER.</span>
        </p>

        <h1 id="home-title">
          <span class="title-cn">像素宇宙</span>
          <span class="title-en">PIXEL UNIVERSE</span>
        </h1>

        <p class="home-description">
          这里记录算法竞赛、计算机科学、科研探索与开发项目，
          也收藏那些来自宇宙的灵感。
          <span class="description-en">
            A personal space for algorithms, computer science, research,
            development and inspiration from the cosmos.
          </span>
        </p>

        <div class="home-actions">
          <a href="/galaxy/" class="primary-button">
            <span class="button-cn">开始探索</span>
            <span class="button-en">START EXPLORING</span>
            <span class="button-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="/archive/" class="secondary-button">
            <span class="button-cn">访问档案</span>
            <span class="button-en">VISIT ARCHIVE</span>
          </a>
        </div>

        <nav class="home-launch-links" aria-label="探索快捷入口">
          <a href="/hangar/">星际机库 <small>HANGAR</small> ↗</a>
          <a href="/hangar/voyage/">航行训练 <small>VOYAGE</small> ↗</a>
          <a href="/explore/">全站探索 <small>EXPLORE</small> ↗</a>
          <a href="/radio/">宇宙电台 <small>RADIO</small> ↗</a>
          <a href="/oracle/">星辰来签 <small>ORACLE</small> ↗</a>
          <a href="/friends/">星际友邻 <small>FRIENDS</small> ↗</a>
          <a href="/memories/collection/">影像图鉴 <small>COLLECTION</small> ↗</a>
        </nav>
        <div class="home-topics">
          <span>✦</span> 算法竞赛 <i>/</i> 科研探索 <i>/</i> 项目开发
        </div>
      </section>

      <section class="planet-area" aria-label="主行星展示">
        <div class="planet-frame">
          <div class="planet-frame-header">
            <span>主行星 / MAIN PLANET</span>
            <span>134340 <b>●</b> 在线 / ONLINE</span>
          </div>

          <div class="planet-art-slot">
            <div class="orbit orbit-one" aria-hidden="true"></div>
            <div class="orbit orbit-two" aria-hidden="true"></div>

            <div class="planet-display">
              <img
                src="/media/images/planets/kenney-generic/planet00.png"
                alt="像素风格行星"
                class="planet-image"
                loading="eager"
                decoding="async"
              />
              <div class="planet-caption">
                <span class="planet-caption-en">PLANET 00</span>
                <span class="planet-caption-cn">未知星域 · 主行星</span>
              </div>
            </div>

            <span class="slot-corner slot-corner-tl" aria-hidden="true"></span>
            <span class="slot-corner slot-corner-br" aria-hidden="true"></span>
          </div>

          <div class="planet-frame-footer">
            <span>位置 / LOCATION：深空 DEEP SPACE</span>
            <span>状态 / STATUS：已就绪 READY</span>
          </div>
        </div>

        <p class="planet-note">
          <span>✦</span> 正在探索未知星域
          <span class="planet-note-en">EXPLORING THE UNKNOWN</span>
        </p>
      </section>
    </div>

    <div class="scene-controls" aria-label="首页背景控制"><button type="button" data-scene-prev aria-label="上一张背景">←</button><span data-scene-label>深空星海 · 1 / 5</span><button type="button" data-scene-next aria-label="下一张背景">→</button><button type="button" data-scene-pause>暂停轮播</button></div>
    <footer class="home-bottom">
      <span>像素宇宙 / PIXEL UNIVERSE · V1.0</span>
      <span>保持好奇，继续探索。 / KEEP CURIOUS, KEEP EXPLORING.</span>
    </footer>
  </section>
</SiteLayout>

<script>
  const bg=document.querySelector<HTMLElement>('[data-home-background]');
  const label=document.querySelector<HTMLElement>('[data-scene-label]');
  const pause=document.querySelector<HTMLButtonElement>('[data-scene-pause]');
  const scenes=[['深空星海','/media/images/backgrounds/scenes/Scene-1.jpg'],['蓝色星域','/media/images/backgrounds/scenes/Scene-2.jpg'],['紫色星海','/media/images/backgrounds/scenes/Scene-3.jpg'],['星云峭壁','/media/images/universe.jpg'],['星云深处','/media/images/backgrounds/nebulae/Space005.png'],['静谧星野','/media/images/backgrounds/community/home.webp']];
  let index=0, stopped=matchMedia('(prefers-reduced-motion: reduce)').matches, timer=0, pending=0;
  function show(i:number){index=(i+scenes.length)%scenes.length;const seq=++pending;const image=new Image();image.onload=()=>{if(seq!==pending)return;bg?.style.setProperty('--home-scene',`url('${scenes[index][1]}')`);if(label)label.textContent=`${scenes[index][0]} · ${index+1} / ${scenes.length}`;};image.src=scenes[index][1];}
  function schedule(){window.clearInterval(timer);if(pause)pause.textContent=stopped?'播放轮播':'暂停轮播';if(!stopped&&!document.hidden)timer=window.setInterval(()=>show(index+1),9000);}
  document.querySelector('[data-scene-prev]')?.addEventListener('click',()=>{show(index-1);schedule();});
  document.querySelector('[data-scene-next]')?.addEventListener('click',()=>{show(index+1);schedule();});
  pause?.addEventListener('click',()=>{stopped=!stopped;schedule();});document.addEventListener('visibilitychange',schedule);schedule();
</script>
<style>
  .scene-controls{position:relative;z-index:2;display:flex;gap:12px;align-items:center;justify-content:center;flex-wrap:wrap;margin:12px 0;color:var(--pu-cyan);font-size:14px;}.scene-controls button{font:inherit;color:var(--pu-text);background:#0b1428b0;border:1px solid #83ced250;padding:7px 12px;cursor:pointer;}.scene-controls button:hover{border-color:var(--pu-cyan);}

  .home-page {
    --pu-space: #0b1428;
    --pu-cyan: #83ced2;
    --pu-purple: #a18bdc;
    --pu-purple-light: #c8b8f4;
    --pu-text: #edf1ff;
    --pu-muted: #c0cbe0;
    --pu-border: rgba(131, 206, 210, 0.34);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 78px);
    padding: 26px clamp(20px, 5vw, 82px) 22px;
    overflow: hidden;
    color: var(--pu-text);
    background: var(--pu-space);
  }

  .home-page *,
  .home-page *::before,
  .home-page *::after { box-sizing: border-box; }

  .home-background {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .home-bg-image {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, rgba(7,13,27,.68), rgba(7,13,27,.34) 52%, rgba(7,13,27,.50)),
      linear-gradient(180deg, rgba(7,13,27,.18), rgba(7,13,27,.22) 55%, rgba(7,13,27,.82)),
      var(--home-scene, url('/media/images/backgrounds/scenes/Scene-1.jpg'));
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .home-bg-grid {
    position: absolute;
    inset: 0;
    opacity: .14;
    background-image:
      linear-gradient(rgba(131,206,210,.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(131,206,210,.12) 1px, transparent 1px);
    background-size: 38px 38px;
  }

  .home-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0,.92fr) minmax(420px,1.08fr);
    align-items: center;
    gap: clamp(34px,5vw,78px);
    width: min(1420px,100%);
    min-height: 680px;
    margin: auto;
  }

  .home-copy { min-width: 0; padding: 44px 0 52px; }

  .home-eyebrow,
  .home-welcome,
  .planet-frame-header,
  .planet-frame-footer,
  .planet-caption-en,
  .planet-note-en,
  .home-bottom {
    font-family: "Courier New", Courier, monospace;
    text-transform: uppercase;
  }

  .home-eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 0 0 46px;
    color: var(--pu-cyan);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 1.8;
  }
  .home-eyebrow span { color: var(--pu-purple); }

  .home-welcome {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin: 0 0 20px;
    color: var(--pu-purple-light);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 1.8;
  }
  .home-welcome span {
    color: rgba(237,241,255,.78);
    font-size: 11px;
    letter-spacing: 3px;
  }

  .home-copy h1 {
    margin: 0 0 28px;
    color: var(--pu-text);
    font-family: "Courier New", "Microsoft YaHei", monospace;
    font-size: clamp(58px,7vw,94px);
    font-weight: 900;
    letter-spacing: .08em;
    line-height: 1.12;
    text-shadow: 5px 5px 0 rgba(52,41,87,.95);
  }
  .title-cn { display: block; letter-spacing: .12em; }
  .title-en {
    display: block;
    margin-top: 12px;
    color: var(--pu-purple);
    font-size: clamp(20px,2.4vw,31px);
    letter-spacing: .2em;
    line-height: 1.4;
    text-shadow: 3px 3px 0 rgba(35,25,65,.95);
  }

  .home-description {
    max-width: 590px;
    margin: 0;
    color: var(--pu-text);
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 2.05;
    text-shadow: 0 2px 8px rgba(0,0,0,.55);
  }
  .description-en {
    display: block;
    margin-top: 9px;
    color: var(--pu-muted);
    font-family: "Courier New", Courier, monospace;
    font-size: 12px;
    line-height: 1.9;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 34px;
  }
  .primary-button,
  .secondary-button {
    position: relative;
    display: inline-flex;
    min-height: 62px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 10px 20px;
    border: 1px solid rgba(200,184,244,.8);
    color: var(--pu-text);
    text-decoration: none;
    transition: background-color .18s ease, border-color .18s ease, transform .18s ease;
  }
  .primary-button {
    min-width: 205px;
    background: #7160b6;
    border: 2px solid #b6a2ed;
    box-shadow: 4px 4px 0 rgba(14,10,30,.9);
  }
  .secondary-button {
    min-width: 165px;
    flex-direction: column;
    gap: 4px;
    background: rgba(8,16,32,.66);
    border-color: rgba(131,206,210,.55);
  }
  .button-cn {
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .button-en {
    color: rgba(237,241,255,.82);
    font-family: "Courier New", Courier, monospace;
    font-size: 9px;
    letter-spacing: 1.3px;
  }
  .primary-button .button-en { color: rgba(255,255,255,.78); }
  .button-arrow { margin-left: auto; font-size: 18px; }
  .primary-button:hover,
  .secondary-button:hover {
    transform: translate(-2px,-2px);
    background-color: #8271b5;
    border-color: var(--pu-cyan);
  }

  .home-topics {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin-top: 30px;
    color: var(--pu-muted);
    font-size: 12px;
    letter-spacing: 1px;
  }
  .home-topics span { color: #e4b96e; }
  .home-topics i { color: var(--pu-purple); font-style: normal; }

  .planet-area { width: 100%; min-width: 0; }
  .planet-frame {
    position: relative;
    padding: 20px;
    border: 1px solid rgba(161,139,220,.72);
    background: rgba(12,23,43,.88);
    box-shadow: 8px 8px 0 rgba(15,10,32,.78);
    backdrop-filter: blur(5px);
  }
  .planet-frame-header,
  .planet-frame-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    color: var(--pu-cyan);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 1.8;
  }
  .planet-frame-header b { color: #80dfb0; font-size: 9px; }

  .planet-art-slot {
    position: relative;
    display: grid;
    min-height: 390px;
    place-items: center;
    margin: 20px 0;
    overflow: hidden;
    border: 1px dashed var(--pu-border);
    background-color: rgba(17,30,53,.48);
    background-image:
      linear-gradient(rgba(131,206,210,.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(131,206,210,.055) 1px, transparent 1px),
      radial-gradient(circle at 50% 50%, rgba(88,91,151,.22), transparent 58%);
    background-size: 32px 32px, 32px 32px, auto;
  }
  .orbit {
    position: absolute;
    width: 76%;
    height: 36%;
    border: 1px dashed rgba(161,139,220,.62);
    border-radius: 50%;
    pointer-events: none;
  }
  .orbit-one { transform: rotate(-25deg); }
  .orbit-two {
    width: 86%;
    height: 49%;
    transform: rotate(34deg);
    border-color: rgba(131,206,210,.42);
  }
  .planet-display {
    position: relative;
    z-index: 2;
    display: flex;
    width: clamp(150px,34%,220px);
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .planet-image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(0 0 12px rgba(161,139,220,.42))
            drop-shadow(0 0 28px rgba(83,123,220,.22));
  }
  .planet-caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    margin-top: 12px;
    text-align: center;
  }
  .planet-caption-en {
    color: var(--pu-cyan);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
  }
  .planet-caption-cn { color: var(--pu-text); font-size: 12px; letter-spacing: 1px; }

  .slot-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--pu-purple);
    border-style: solid;
    opacity: .9;
  }
  .slot-corner-tl { top: 10px; left: 10px; border-width: 1px 0 0 1px; }
  .slot-corner-br { right: 10px; bottom: 10px; border-width: 0 1px 1px 0; }

  .planet-frame-footer { color: var(--pu-muted); font-size: 9px; letter-spacing: .6px; }
  .planet-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin: 17px 2px 0;
    color: var(--pu-text);
    font-size: 12px;
    letter-spacing: 1px;
  }
  .planet-note > span:first-child { color: #e4b96e; }
  .planet-note-en { color: var(--pu-cyan); font-size: 9px; letter-spacing: 1px; }

  .home-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(1420px,100%);
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    margin: 22px auto 0;
    padding-top: 15px;
    border-top: 1px solid rgba(131,206,210,.22);
    color: rgba(192,203,224,.82);
    font-size: 10px;
    letter-spacing: 1px;
    line-height: 1.8;
  }

  @media (max-width: 1050px) {
    .home-content {
      grid-template-columns: minmax(0,1fr) minmax(340px,.9fr);
      gap: 30px;
    }
    .home-copy h1 { font-size: clamp(52px,6vw,76px); }
    .planet-art-slot { min-height: 330px; }
  }

  @media (max-width: 800px) {
    .home-page {
      min-height: calc(100svh - 68px);
      padding: 22px 20px 20px;
    }
    .home-content {
      grid-template-columns: minmax(0,1fr);
      gap: 30px;
      min-height: 0;
      width: min(650px,100%);
    }
    .home-copy { padding: 38px 0 0; }
    .home-eyebrow { margin-bottom: 30px; font-size: 10px; }
    .home-welcome { margin-bottom: 15px; }
    .home-copy h1 { font-size: clamp(48px,11vw,76px); }
    .planet-art-slot { min-height: 320px; }
    .home-bottom { width: min(650px,100%); margin-top: 30px; }
  }

  @media (max-width: 520px) {
    .home-page { padding-right: 16px; padding-left: 16px; }
    .home-copy h1 { font-size: clamp(42px,12vw,60px); letter-spacing: .04em; }
    .title-en { font-size: 17px; letter-spacing: .13em; }
    .home-description { font-size: 14px; }
    .description-en { font-size: 11px; }
    .home-actions { align-items: stretch; flex-direction: column; }
    .primary-button, .secondary-button { width: 100%; }
    .planet-frame { padding: 13px; }
    .planet-art-slot { min-height: 270px; margin: 15px 0; }
    .planet-display { width: 42%; }
    .planet-frame-header, .planet-frame-footer { font-size: 8px; }
    .home-bottom { flex-direction: column; font-size: 9px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-button, .secondary-button { transition: none; }
  }
  .home-launch-links{display:flex;flex-wrap:wrap;gap:10px 24px;margin-top:25px;}
  .home-launch-links a{color:var(--pu-cyan);font-size:15px;border-bottom:1px solid #83ced266;padding:5px 0;}
  .home-launch-links a:hover{color:#fff;border-color:#fff;}.home-launch-links small{font-family:var(--font-pixel-en,monospace);font-size:15px;color:var(--pu-muted);margin-left:4px;}
</style>
