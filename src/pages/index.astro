---
import SiteLayout from '../layouts/SiteLayout.astro';
import { destinations, activities } from '../data/navigation';
import homeConfig from '../data/home-v03.json';
import '../styles/home-v03.css';
const knownRoutes = [...destinations, ...activities];
const homeDestinations = homeConfig.destinations.map(item => {
  const current = knownRoutes.find(route => route.href === item.href);
  return current ? { ...item, cn: current.name, href: current.href } : item;
});
const config = { ...homeConfig, destinations: homeDestinations };
const configJSON = JSON.stringify(config).replace(/</g, '\\u003c');
---
<SiteLayout title="像素宇宙 | Pixel Universe" description="记录算法、科研与开发实践，收藏来自宇宙的灵感。">
  <div id="mpc-home">
<section aria-label="宇宙远航" class="hero"><div class="scene" id="mpc-home-scene" style="background-image:url('/media/home-v03/thumb_deep.png')"></div><div class="shade"></div><button class="imm-exit" id="mpc-home-exitImm" type="button">退出观景 · Esc</button><div class="hero-top mono"><span>SECTOR / 134340   ·   远航枢纽</span><div class="hero-top-actions"><span class="status" id="mpc-home-sceneStatus">SCENE 01 / 06</span><button id="mpc-home-openCommand" type="button" aria-label="打开星际指令终端" aria-haspopup="dialog" title="指令终端 · Ctrl / Cmd + K">指令终端</button></div></div><div class="copy"><div class="eyebrow mono">WELCOME, EXPLORER</div><h1>像素宇宙<small>PIXEL UNIVERSE</small></h1><p class="intro">记录算法、科研与开发实践，收藏来自宇宙的灵感。<br/>从这里，驶向未知星域。</p><div class="actions"><a class="primary dest" data-id="galaxy" href="/galaxy/">开始探索 <span>↗</span></a><a class="secondary dest" data-id="cabin" href="/cabin/">进入个人舱 <span>↗</span></a></div></div><div class="hero-bottom"><div class="route-area"><div class="route-head mono"><strong id="mpc-home-sceneName"></strong><span id="mpc-home-sceneEn"></span></div><div aria-label="星际航线" class="route" id="mpc-home-route"></div><p class="scene-desc" id="mpc-home-sceneDesc"></p></div><div class="control-dock"><button id="mpc-home-dockToggle" type="button" aria-expanded="false" aria-controls="mpc-home-dockPanel"><span>场景控制</span></button><div class="scene-tools" id="mpc-home-dockPanel" hidden><div class="dock-heading"><span>场景控制 <small>FLIGHT CONTROL</small></span><button type="button" id="mpc-home-dockClose" aria-label="收起场景控制">×</button></div><button aria-label="上一场景" id="mpc-home-prev" type="button">← 上一站</button><button aria-label="下一场景" id="mpc-home-next" type="button">下一站 →</button><button aria-pressed="true" id="mpc-home-auto" type="button">暂停轮播</button><button id="mpc-home-imm" type="button">观景模式</button><button aria-pressed="true" id="mpc-home-motion" type="button">动效：开</button><button id="mpc-home-settings" type="button">环境设置</button></div></div></div></section><div class="content" id="mpc-home-content"><div class="section-head"><div><div class="kicker mono">01 / QUICK ROUTES</div><h2>快捷航线</h2></div><p>常用目的地 · 直接抵达</p></div><div class="quick" id="mpc-home-quick"></div><section hidden="" id="mpc-home-recentSection"><div class="section-head"><div><div class="kicker mono">02 / RECENT</div><h2>最近探索</h2></div><p>仅保存在当前浏览器</p></div><div class="recent" id="mpc-home-recent"></div></section><div class="section-head"><div><div class="kicker mono">03 / DESTINATIONS</div><h2>星域探索</h2></div><p>每个栏目都是一处目的地</p></div><div class="gallery" id="mpc-home-gallery"></div></div><div class="home-credit"><span>MPC / PIXEL UNIVERSE · HOME V0.3.3</span><span>原始像素素材：Ansimuz · Kelano Studio · Foozle · Pixelarticons <button id="mpc-home-credits" style="padding:5px 10px;margin-left:8px" type="button">素材与说明</button></span></div><dialog aria-label="星际指令终端" id="mpc-home-cmd"><div class="dialog-head"><strong>星际指令终端 / COMMAND</strong><button aria-label="关闭" data-close="cmd" type="button">×</button></div><input aria-label="搜索目的地、场景或命令" autocomplete="off" id="mpc-home-search" placeholder="搜索目的地、场景或命令"/><div class="results" id="mpc-home-results"></div></dialog><dialog aria-label="环境设置" id="mpc-home-prefs"><div class="dialog-head"><strong>环境设置 / ENVIRONMENT</strong><button aria-label="关闭" data-close="prefs" type="button">×</button></div><div class="settings"><label><input id="mpc-home-prefAuto" type="checkbox"/>自动轮播</label><label><input id="mpc-home-prefMotion" type="checkbox"/>环境动效与视差</label><label><input id="mpc-home-prefShips" type="checkbox"/>显示飞船与前景事件</label><button id="mpc-home-reset" type="button">恢复默认设置</button><button id="mpc-home-clearHistory" type="button">清除首页探索记录</button><p>仅保存本首页的设置，不读取、清除或上传其他页面的存档。默认静音。</p></div></dialog><dialog aria-label="素材来源" id="mpc-home-info"><div class="dialog-head"><strong>素材来源及说明</strong><button aria-label="关闭" data-close="info" type="button">×</button></div><div class="settings"><p>首页视觉为基于原始像素素材的合成艺术场景，不是实际天文观测。</p><a href="https://ansimuz.itch.io/space-background">Ansimuz · Space Backgrounds</a><a href="https://ansimuz.itch.io/warped-vehicles">Ansimuz · Warped Vehicles</a><a href="https://ansimuz.itch.io/star-fighter">Ansimuz · Star Fighter</a><a href="https://kelano-studio.itch.io/alien-skies">Kelano Studio · Alien Skies</a><a href="https://foozlecc.itch.io/void-environment-pack">Foozle · Void Environment Pack</a><a href="https://github.com/halfmage/pixelarticons">Pixelarticons · Gerrit Halfmann (MIT)</a><p>Alien Skies 用于本网站合成场景及栏目封面，不提供原始素材包下载。公开源码分发前须确认许可边界。</p></div></dialog>
    <noscript><nav class="nojs-links" aria-label="站内导航">{homeDestinations.map(item => <a href={item.href}>{item.cn}</a>)}</nav></noscript>
    <script is:inline id="mpc-home-data" type="application/json" set:html={configJSON}></script>
    <script is:inline src="/scripts/home-v03.js" defer></script>
  </div>
</SiteLayout>
