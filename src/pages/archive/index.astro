---
import type { MarkdownInstance } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { categories, categoryName, type ArchiveFrontmatter } from '../../data/archive';

const files = import.meta.glob<MarkdownInstance<ArchiveFrontmatter>>('./articles/*.md', { eager: true });
const articles = Object.entries(files).map(([path, file]) => ({
  ...file.frontmatter,
  href: '/archive/articles/' + path.split('/').pop()!.replace(/\.md$/, '') + '/',
})).sort((a, b) => a.title.localeCompare(b.title, 'zh-CN'));
---

<SiteLayout title="知识档案 | Archive" description="算法、科研、开发与学习笔记。">
  <section class="page-container archive-page">
    <PageIntro eyebrow="03 / KNOWLEDGE ARCHIVE" title="知识档案" description="将算法、科研与技术实践整理为可检索、可持续更新的知识记录。" />
    <section class="archive-banner">
      <div class="archive-copy">
        <span class="eyebrow">PERSONAL KNOWLEDGE BASE</span>
        <h2>每一次探索，<br /><em>都值得记录。</em></h2>
        <p>按主题浏览文章、题解与学习指南。</p>
        <a href="#archive-index">浏览文章 ↓</a>
      </div>
      <div class="archive-count"><strong>{articles.length.toString().padStart(2,'0')}</strong><span>篇文章 / ARTICLES</span></div>
    </section>
    <section id="archive-index" class="archive-index">
      <div class="index-heading"><h2>文章目录</h2><span>ARTICLE INDEX</span></div>
      <form id="archive-search" role="search" class="archive-search">
        <div class="field"><label for="archive-keyword">搜索文章</label><input id="archive-keyword" type="search" placeholder="标题、摘要、标签" /></div>
        <div class="field"><label for="archive-category">文章分类</label><select id="archive-category"><option value="all">全部分类</option>{categories.map(c => <option value={c.id}>{c.cn}</option>)}</select></div>
        <button type="reset">清空筛选</button>
      </form>
      <p id="archive-result" class="archive-result" aria-live="polite">共 {articles.length} 篇文章</p>
      <div class="article-list">
        {articles.map(article => (
          <article class="article-row" data-category={article.category} data-search={[article.title, article.description, categoryName(article.category), ...(article.tags ?? [])].join(' ')}>
            <div class="article-meta"><span>{categoryName(article.category)}</span>{article.sample && <small>示例指南</small>}</div>
            <div class="article-copy"><h3><a href={article.href}>{article.title}</a></h3><p>{article.description}</p>{article.tags?.length ? <div class="tags">{article.tags.map(tag => <span>{tag}</span>)}</div> : null}</div>
            <a class="read-link" href={article.href} aria-label={`阅读 ${article.title}`}>阅读 ↗</a>
          </article>
        ))}
        <p id="archive-empty" hidden>没有符合条件的文章，请尝试其他关键词。</p>
      </div>
    </section>
  </section>
</SiteLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#archive-search');
  const keyword = document.querySelector<HTMLInputElement>('#archive-keyword');
  const category = document.querySelector<HTMLSelectElement>('#archive-category');
  const result = document.querySelector<HTMLElement>('#archive-result');
  const empty = document.querySelector<HTMLElement>('#archive-empty');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.article-row'));
  function filterArticles() {
    const terms = (keyword?.value ?? '').trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
    const selected = category?.value ?? 'all';
    let count = 0;
    for (const row of rows) {
      const content = (row.dataset.search ?? '').toLocaleLowerCase();
      const visible = (selected === 'all' || selected === row.dataset.category) && terms.every(t => content.includes(t));
      row.hidden = !visible;
      if (visible) count++;
    }
    if (result) result.textContent = `共 ${count} 篇文章`;
    if (empty) empty.hidden = count !== 0;
  }
  form?.addEventListener('submit', event => { event.preventDefault(); filterArticles(); });
  keyword?.addEventListener('input', filterArticles);
  category?.addEventListener('change', filterArticles);
  form?.addEventListener('reset', () => queueMicrotask(filterArticles));
</script>

<style>
  .archive-banner { min-height: 280px; padding: clamp(24px,5vw,52px); display:flex; align-items:center; justify-content:space-between; gap:32px; background:linear-gradient(90deg,rgba(7,13,27,.94),rgba(7,13,27,.56)),url('/media/images/backgrounds/nebulae/Space003.png') center/cover; border-block:1px solid var(--border); }
  .archive-copy h2 { font-size:clamp(30px,4vw,49px); line-height:1.4; margin:16px 0; }
  .archive-copy em { color:#b8a3f0; font-style:normal; }
  .archive-copy p { font-size:16px; color:var(--muted); }
  .archive-copy a { color:var(--cyan); font-size:16px; text-decoration:underline; text-underline-offset:5px; }
  .archive-count { display:grid; text-align:right; flex-shrink:0; gap:6px; }
  .archive-count strong { font:700 clamp(48px,8vw,96px)/1 monospace; color:var(--cyan); }
  .archive-count span,.index-heading span { font:13px monospace; color:var(--muted); }
  .archive-index { margin-top:64px; }
  .index-heading { display:flex; align-items:baseline; flex-wrap:wrap; gap:14px; }
  .index-heading h2 { font-size:28px; }
  .archive-search { display:grid; grid-template-columns:minmax(0,1fr) minmax(160px,.45fr) auto; align-items:end; gap:16px; padding:18px 0; border-bottom:1px solid var(--border); }
  .field { display:grid; gap:8px; min-width:0; }
  .field label { color:var(--muted); font-size:14px; }
  input,select,button { min-height:44px; border:1px solid var(--border); background:var(--panel); color:var(--text); border-radius:4px; font:inherit; padding:8px 12px; }
  button { cursor:pointer; color:var(--cyan); }
  input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible { outline:2px solid var(--cyan); outline-offset:3px; }
  .archive-result { color:var(--muted); font-size:14px; margin:18px 0 6px; }
  .article-row { display:grid; grid-template-columns:130px minmax(0,1fr) auto; align-items:center; gap:24px; padding:24px 0; border-bottom:1px solid var(--border); }
  .article-row[hidden], #archive-empty[hidden] { display:none; }
  .article-meta { display:flex; flex-direction:column; gap:6px; color:var(--cyan); font-size:15px; }
  .article-meta small { color:var(--muted); font-size:12px; }
  .article-copy h3 { margin:0; font-size:20px; }
  .article-copy p { color:var(--muted); font-size:15px; margin:8px 0; }
  .tags { display:flex; flex-wrap:wrap; gap:14px; color:#b8a3f0; font-size:13px; }
  .tags span::before { content:'#'; }
  .read-link { color:var(--cyan); font-size:15px; white-space:nowrap; }
  .read-link:hover,.article-copy a:hover { text-decoration:underline; }
  #archive-empty { padding:24px 0; color:var(--muted); }
  @media(max-width:650px) { .archive-banner { align-items:flex-start; flex-direction:column; } .archive-count { text-align:left; } .archive-search { grid-template-columns:1fr; } .article-row { grid-template-columns:1fr; gap:9px; } .article-meta { flex-direction:row; align-items:baseline; gap:12px; } }
</style>
