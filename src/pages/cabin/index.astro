---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';

const modules = [
  { title: '星际机库', en: 'HANGAR', description: '选择飞船并进入航行训练。', href: '/hangar/' },
  { title: '个人工作台', en: 'WORKBENCH', description: '记录任务、整理学习目标与项目进度。', href: '/cabin/workbench/' },
  { title: '知识档案', en: 'KNOWLEDGE DESK', description: '算法竞赛、开发项目与科研探索。', href: '/archive/' },
  { title: '记忆星球', en: 'STAR LIBRARY', description: '宇宙影像与个人收藏。', href: '/memories/' },
  { title: '深空观测站', en: 'OBSERVATION DECK', description: '宇宙影像、天文观察与研究日志。', href: '/observatory/' },
];

const stations = [
  { title: '个人工作台', en: 'WORKBENCH', href: '/cabin/workbench/', x: 16.25, y: 65.6 },
  { title: '知识档案', en: 'ARCHIVE', href: '/archive/', x: 50, y: 65.6 },
  { title: '记忆星球', en: 'MEMORIES', href: '/memories/', x: 82.5, y: 65.6 },
  { title: '深空观测', en: 'OBSERVATORY', href: '/observatory/', x: 50, y: 19 },
];

const windowViews = [
  { src: '/media/images/backgrounds/scenes/Scene-3.jpg', title: '紫色星域', en: 'VIOLET SECTOR' },
  { src: '/media/images/backgrounds/nebulae/Space001.png', title: '翡翠星云', en: 'EMERALD NEBULA' },
  { src: '/media/images/universe.jpg', title: '深空全景', en: 'DEEP SPACE VIEW' },
];
---

<SiteLayout
  title="个人舱 | My Cabin"
  description="像素宇宙中的个人空间站，记录学习、项目与探索方向。"
>
  <section class="page-container cabin-page">
    <PageIntro
      eyebrow="02 / PERSONAL SPACE"
      title="我的个人舱"
      description="一处安静的星际角落。这里记录我的学习方向、项目进度与持续探索的兴趣。"
    />

    <section class="cabin-layout">
      <div class="cabin-scene">
        <div class="scene-header">
          <span>个人空间 / PERSONAL QUARTERS</span>
          <span>SECTOR 134340</span>
        </div>

        <div class="interactive-cabin">
          <img src="/media/images/cabin/personal-quarters.png" alt="像素太空舱：窗前有电脑、书架和全息桌" width="320" height="192" />
          {stations.map((station) => (
            <a class="cabin-hotspot" href={station.href} aria-label={station.title} style={`--x:${station.x}%;--y:${station.y}%`}>
              <span class="hotspot-dot" aria-hidden="true"></span>
              <span class="hotspot-label">{station.title}</span>
            </a>
          ))}
        </div>
        <p class="cabin-help">点击电脑、书架、全息桌或舷窗，前往对应功能。</p>
        <nav class="cabin-shortcuts" aria-label="个人舱快捷入口">
          {stations.map((station) => <a href={station.href}>{station.title}<small lang="en">{station.en}</small></a>)}
          <a href="/hangar/">星际机库<small lang="en">HANGAR</small></a>
          <a href="/hangar/voyage/">航行训练<small lang="en">VOYAGE</small></a>
        </nav>
      </div>

      <aside class="profile-panel">
        <div class="profile-header">
          <span>探索者档案 / EXPLORER PROFILE</span>
        </div>

        <div class="profile-emblem">
          <img src="/media/images/planets/kenney-generic/planet03.png" alt="个人舱像素星体徽记" />
        </div>

        <h2>关于我 <small lang="en">ABOUT ME</small></h2>
        <p class="profile-description">
          计算机科学专业学生，关注算法竞赛、科研探索和软件开发。
          <span>A computer science student exploring algorithms, research and programming.</span>
        </p>

        <div class="profile-divider"></div>

        <div class="profile-info">
          <div><small>学习目标 / GOAL</small><strong>持续学习与实践</strong></div>
          
          <div><small>兴趣方向 / INTEREST</small><strong>算法 · 科研 · 开发</strong></div>
        </div>
      </aside>
    </section>

    <section class="cabin-views">
      <div class="section-heading">
        <div><span class="section-label">WINDOW VIEWS</span><h2>舷窗之外</h2></div>
        
      </div>
      <div class="view-gallery">
        {windowViews.map((view, index) => (
          <figure>
            <img src={view.src} alt={view.title} loading="lazy" />
            <figcaption><span>0{index + 1}</span><div><strong>{view.title}</strong><small>{view.en}</small></div></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="cabin-modules">
      <div class="section-heading">
        <div><span class="section-label">CABIN MODULES</span><h2>探索入口</h2></div>
        
      </div>
      <div class="module-list">
        {modules.map((module, index) => (
          <a href={module.href} class="module-row">
            <span class="module-number">0{index + 1}</span>
            <div><strong>{module.title}</strong><small>{module.en}</small></div>
            <p>{module.description}</p>
            <span class="module-arrow">↗</span>
          </a>
        ))}
      </div>
    </section>
  </section>
</SiteLayout>

<style>
  .cabin-page { position:relative; }
  .section-label { color:var(--cyan); font:12px monospace; letter-spacing:2px; }
  .section-heading { display:flex; justify-content:space-between; align-items:end; gap:15px; margin-bottom:24px; }
  .section-heading h2 { margin:8px 0 0; font-size:clamp(23px,3vw,30px); }
  .section-heading > p { margin:0 0 4px; color:var(--muted); font:12px monospace; letter-spacing:1px; }
  .cabin-layout { display:grid; grid-template-columns:1.45fr .75fr; gap:30px; align-items:stretch; }
  .cabin-scene { min-width:0; }
  .scene-header,.scene-footer { display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; color:var(--cyan); font:12px monospace; letter-spacing:1px; }
  .scene-image { position:relative; min-height:440px; margin:16px 0; overflow:hidden; isolation:isolate; display:flex; align-items:flex-end; padding:30px; background:#0b1428; }
  .cabin-backdrop,.cabin-image-shade { position:absolute; inset:0; width:100%; height:100%; }
  .cabin-backdrop { z-index:-2; object-fit:cover; }
  .cabin-image-shade { z-index:-1; background:linear-gradient(0deg,rgba(5,10,24,.9),rgba(5,10,24,.05) 75%),linear-gradient(90deg,rgba(5,10,24,.3),transparent); }
  .scene-label { display:flex; flex-direction:column; gap:7px; position:relative; z-index:2; text-shadow:0 2px 8px #050b17; }
  .scene-label span { color:var(--cyan); font:12px monospace; letter-spacing:2px; }
  .scene-label strong { color:#f0edff; font-size:26px; letter-spacing:2px; }
  .scene-label small { color:#d0d8eb; font:12px monospace; letter-spacing:1px; }
  .scene-coordinate { position:absolute; top:16px; right:18px; color:#dbe6f5; font:12px monospace; letter-spacing:1px; }
  .debris { position:absolute; z-index:1; image-rendering:pixelated; opacity:.8; filter:drop-shadow(0 3px 5px rgba(0,0,0,.5)); }
  .debris-one { width:72px; bottom:8px; right:10%; }
  .debris-two { width:38px; bottom:20px; right:25%; }
  .debris-three { width:42px; bottom:14px; left:8%; }
  .debris-four { width:64px; bottom:5px; left:28%; opacity:.6; }
  .profile-panel { padding:22px 24px; background:linear-gradient(160deg,rgba(25,41,68,.9),rgba(11,20,40,.94)); border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
  .profile-header { display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; color:var(--cyan); font:12px monospace; }
  .online-dot { color:#83d9a9; }
  .profile-emblem { width:116px; height:116px; margin:38px auto 15px; display:grid; place-items:center; background:radial-gradient(circle,rgba(130,113,181,.2),transparent 70%); }
  .profile-emblem img { width:100%; height:100%; object-fit:contain; image-rendering:pixelated; filter:drop-shadow(0 0 18px rgba(130,113,181,.4)); }
  .profile-panel h2 { margin:10px 0; text-align:center; font:700 14px monospace; letter-spacing:2px; }
  .profile-description { color:var(--muted); font-size:15px; line-height:1.85; text-align:center; }
  .profile-description span { display:block; margin-top:8px; font:12px/1.8 monospace; }
  .profile-divider { height:1px; margin:25px 0; background:var(--border); }
  .profile-info { display:grid; gap:19px; }
  .profile-info div { display:flex; flex-direction:column; gap:5px; }
  .profile-info small { color:var(--muted); font-size:14px; }
  .profile-info strong { color:var(--warm); font-size:14px; font-weight:500; }
  .cabin-views,.cabin-modules { margin-top:70px; }
  .view-gallery { display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:18px; }
  .view-gallery figure { position:relative; margin:0; overflow:hidden; }
  .view-gallery img { width:100%; aspect-ratio:16/10; object-fit:cover; }
  .view-gallery figcaption { position:absolute; inset:auto 0 0; display:flex; gap:10px; align-items:center; padding:25px 12px 12px; background:linear-gradient(transparent,rgba(5,10,24,.9)); }
  .view-gallery figcaption > span { color:var(--cyan); font:12px monospace; }
  .view-gallery figcaption div { display:flex; flex-direction:column; gap:3px; }
  .view-gallery strong { font-size:14px; }
  .view-gallery small { color:var(--cyan); font:12px monospace; }
  .module-list { border-top:1px solid var(--border); }
  .module-row { display:grid; grid-template-columns:35px 1fr 1.2fr 25px; align-items:center; gap:16px; min-height:86px; border-bottom:1px solid rgba(131,206,210,.18); transition:background .2s; }
  .module-row:hover { background:rgba(25,41,68,.45); }
  .module-number { color:var(--cyan); font:12px monospace; }
  .module-row img { width:28px; height:28px; object-fit:contain; image-rendering:pixelated; }
  .module-row div { display:flex; flex-direction:column; gap:4px; }
  .module-row strong { font-size:14px; }
  .module-row small { color:var(--cyan); font:12px monospace; letter-spacing:1px; }
  .module-row p { color:var(--muted); font-size:14px; }
  .module-arrow { color:var(--nebula); font-size:20px; text-align:right; }
  @media(max-width:850px) { .cabin-layout { grid-template-columns:1fr; } .profile-panel { padding:22px; } .profile-info { grid-template-columns:repeat(2,1fr); } }
  @media(max-width:600px) { .scene-image { min-height:320px; padding:20px; } .view-gallery { grid-template-columns:1fr; } .module-row { grid-template-columns:24px 1fr 20px; gap:10px; padding:12px 0; } .module-row p { display:none; } .profile-info { grid-template-columns:1fr; } .section-heading { align-items:start; flex-direction:column; } }
  .profile-panel h2 { font-family: inherit; font-size: 20px; }
  .profile-panel h2 small { display:block; color:var(--cyan); font:12px monospace; margin-top:6px; }
  .interactive-cabin { position:relative; margin:16px 0 10px; isolation:isolate; background:#070d1b; border:1px solid var(--border); }
  .interactive-cabin > img { display:block; width:100%; height:auto; image-rendering:pixelated; }
  .cabin-hotspot { position:absolute; left:var(--x); top:var(--y); transform:translate(-50%,-50%); display:grid; justify-items:center; gap:4px; min-width:44px; min-height:44px; padding:6px; align-content:center; color:#fff; text-decoration:none; }
  .hotspot-dot { width:13px; height:13px; border:2px solid #e6f9ff; border-radius:50%; background:#83ced2; box-shadow:0 0 9px #83ced2; }
  .hotspot-label { padding:3px 7px; white-space:nowrap; font-size:12px; background:#081326ed; color:#edf1ff; }
  .cabin-hotspot:hover .hotspot-label,.cabin-hotspot:focus-visible .hotspot-label { color:#83ced2; }
  .cabin-hotspot:focus-visible,.cabin-shortcuts a:focus-visible { outline:2px solid #83ced2; outline-offset:3px; }
  .cabin-help { color:var(--muted); font-size:14px; margin:12px 0; }
  .cabin-shortcuts { display:flex; flex-wrap:wrap; gap:12px 22px; }
  .cabin-shortcuts a { display:grid; color:var(--text); font-size:15px; padding:4px 0; border-bottom:1px solid var(--border); }
  .cabin-shortcuts a small { font-size:12px; color:var(--cyan); }
  @media(max-width:500px) { .hotspot-label { display:none; } .hotspot-dot { width:12px; height:12px; } .cabin-shortcuts { display:grid; grid-template-columns:1fr 1fr; } }
</style>
