---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
const shortcuts = [
  { title: '算法与技术笔记', en: 'ARCHIVE', href: '/archive/' },
  { title: '科研阅读指南', en: 'RESEARCH', href: '/archive/articles/paper-reading/' },
  { title: '太阳系探索', en: 'SOLAR SYSTEM', href: '/solar-system/' },
  { title: '深空影像', en: 'OBSERVATORY', href: '/observatory/' },
];
---
<SiteLayout title="个人工作台 | Workbench" description="管理个人学习与项目任务。">
  <section class="page-container workbench">
    <a class="back" href="/cabin/">← 返回个人舱</a>
    <PageIntro eyebrow="PERSONAL CABIN / WORKBENCH" title="个人工作台" description="整理学习任务、科研阅读和开发计划，让每一次探索都有清晰的下一步。" />
    <div class="workbench-layout">
      <section class="task-section" aria-labelledby="task-title">
        <div class="section-heading"><h2 id="task-title">任务清单</h2><span>MISSION LOG</span></div>
        <p class="privacy-note">任务仅保存在当前浏览器，不上传服务器，也不会跨设备同步。请不要在此保存密码或敏感信息。</p>
        <div class="progress-label"><strong id="task-progress-text" aria-live="polite">已完成 0 / 0</strong><span id="task-percent">0%</span></div>
        <progress id="task-progress" value="0" max="1" aria-label="任务完成进度"></progress>
        <form id="task-form" class="task-form">
          <label for="task-input">新增任务</label>
          <div class="task-input-row"><input id="task-input" required maxlength="160" placeholder="例如：复习线段树" /><button type="submit">添加</button></div>
          <label for="task-category">分类</label>
          <select id="task-category"><option value="学习">学习</option><option value="算法">算法</option><option value="科研">科研</option><option value="开发">开发</option><option value="其他">其他</option></select>
        </form>
        <p id="task-status" role="status" class="task-status"></p>
        <ul id="task-list" class="task-list" aria-label="任务列表"></ul>
        <p id="task-empty" class="empty">还没有任务。添加第一项探索计划吧。</p>
        <button class="clear-button" id="clear-done" type="button" disabled>清除已完成任务</button>
        <noscript><p>任务管理需要启用 JavaScript。其他页面仍可正常浏览。</p></noscript>
      </section>
      <aside class="shortcut-section">
        <img src="/media/images/backgrounds/scenes/Scene-2.jpg" alt="深空中的行星与星光" loading="lazy" />
        <div class="section-heading"><h2>快捷入口</h2><span>QUICK ACCESS</span></div>
        <nav aria-label="工作台快捷入口">{shortcuts.map(link => <a href={link.href}><div><strong>{link.title}</strong><small>{link.en}</small></div><span aria-hidden="true">↗</span></a>)}</nav>
      </aside>
    </div>
  </section>
</SiteLayout>
<script>
  type Task = { id: string; text: string; category: string; done: boolean };
  const key = 'pixel-universe.workbench.tasks.v1';
  const form = document.querySelector<HTMLFormElement>('#task-form');
  const input = document.querySelector<HTMLInputElement>('#task-input');
  const category = document.querySelector<HTMLSelectElement>('#task-category');
  const list = document.querySelector<HTMLUListElement>('#task-list');
  const empty = document.querySelector<HTMLElement>('#task-empty');
  const status = document.querySelector<HTMLElement>('#task-status');
  const progress = document.querySelector<HTMLProgressElement>('#task-progress');
  const progressText = document.querySelector<HTMLElement>('#task-progress-text');
  const percent = document.querySelector<HTMLElement>('#task-percent');
  const clear = document.querySelector<HTMLButtonElement>('#clear-done');
  let tasks: Task[] = [];
  let storageAvailable = true;
  function validTask(value: unknown): value is Task {
    if (typeof value !== 'object' || value === null) return false;
    const t = value as Record<string, unknown>;
    return typeof t.id === 'string' && typeof t.text === 'string' && typeof t.category === 'string' && typeof t.done === 'boolean';
  }
  try {
    const raw = localStorage.getItem(key);
    const parsed: unknown = raw ? JSON.parse(raw) : [];
    if (Array.isArray(parsed)) tasks = parsed.filter(validTask);
  } catch { storageAvailable = false; }
  function save() {
    try { localStorage.setItem(key, JSON.stringify(tasks)); storageAvailable = true; }
    catch { storageAvailable = false; }
  }
  function announce(message: string) {
    if (status) status.textContent = storageAvailable ? message : `${message}（本地存储不可用，刷新后可能丢失）`;
  }
  function render() {
    if (!list) return;
    list.replaceChildren();
    for (const task of tasks) {
      const row = document.createElement('li');
      row.className = 'task-row';
      if (task.done) row.classList.add('is-done');
      const label = document.createElement('label');
      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox'; checkbox.checked = task.done;
      const text = document.createElement('span'); text.textContent = task.text;
      label.append(checkbox, text);
      const tag = document.createElement('small'); tag.textContent = task.category;
      const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = '删除';
      remove.setAttribute('aria-label', `删除任务：${task.text}`);
      checkbox.addEventListener('change', () => {
        task.done = checkbox.checked; save(); render();
        // Re-rendering replaces controls: restore focus to the same task.
        const index = tasks.indexOf(task);
        list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')[index]?.focus();
        announce(task.done ? '任务已完成。' : '任务已恢复。');
      });
      remove.addEventListener('click', () => { tasks = tasks.filter(t => t !== task); save(); render(); input?.focus(); announce('任务已删除。'); });
      row.append(label, tag, remove); list.append(row);
    }
    const done = tasks.filter(t => t.done).length;
    if (empty) empty.hidden = tasks.length !== 0;
    if (progress) { progress.max = Math.max(tasks.length, 1); progress.value = done; }
    if (progressText) progressText.textContent = `已完成 ${done} / ${tasks.length}`;
    if (percent) percent.textContent = `${tasks.length ? Math.round(done / tasks.length * 100) : 0}%`;
    if (clear) clear.disabled = !done;
  }
  form?.addEventListener('submit', event => {
    event.preventDefault();
    const text = input?.value.trim();
    if (!text) { announce('请输入任务内容。'); input?.focus(); return; }
    tasks.push({ id: `${Date.now()}-${Math.random().toString(36).slice(2)}`, text: text.slice(0,160), category: category?.value ?? '其他', done: false });
    save(); render(); form.reset(); input?.focus(); announce('任务已添加。');
  });
  clear?.addEventListener('click', () => { tasks = tasks.filter(t => !t.done); save(); render(); input?.focus(); announce('已清除完成的任务。'); });
  render();
  if (!storageAvailable) announce('无法读取浏览器存储。');
</script>
<style>
  .back { display:inline-block; color:var(--cyan); margin-bottom:16px; }
  .workbench-layout { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(240px,.7fr); gap:50px; align-items:start; }
  .section-heading { display:flex; gap:14px; flex-wrap:wrap; align-items:baseline; }
  .section-heading h2 { font-size:25px; margin:0; }
  .section-heading span { color:var(--cyan); font:13px monospace; }
  .privacy-note,.empty { color:var(--muted); font-size:14px; }
  .progress-label { display:flex; justify-content:space-between; margin-top:24px; color:var(--cyan); }
  progress { width:100%; height:10px; accent-color:var(--cyan); margin:12px 0 22px; }
  .task-form { display:grid; gap:9px; padding-bottom:20px; border-bottom:1px solid var(--border); }
  .task-form label { font-size:14px; color:var(--muted); }
  .task-input-row { display:flex; gap:10px; }
  input,select,button { border:1px solid var(--border); background:var(--panel); color:var(--text); font:inherit; border-radius:4px; min-height:44px; padding:8px 12px; }
  .task-input-row input { flex:1; min-width:0; }
  .task-input-row button { background:#62529e; color:white; }
  button { cursor:pointer; }
  button:disabled { opacity:.45; cursor:default; }
  a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible { outline:2px solid var(--cyan); outline-offset:3px; }
  .task-form select { width:min(100%,200px); }
  .task-status { min-height:1.5em; color:var(--cyan); font-size:14px; }
  .task-list { list-style:none; padding:0; margin:0; }
  .task-list :global(.task-row) { display:flex; align-items:center; flex-wrap:wrap; gap:12px; padding:12px 0; border-bottom:1px solid var(--border); }
  .task-list :global(.task-row label) { flex:1; display:flex; align-items:center; gap:10px; min-width:120px; font-size:16px; overflow-wrap:anywhere; }
  .task-list :global(.task-row input) { width:18px; height:18px; flex-shrink:0; accent-color:var(--cyan); }
  .task-list :global(.task-row small) { color:var(--cyan); }
  .task-list :global(.task-row button) { font:inherit; font-size:13px; padding:6px 10px; cursor:pointer; color:var(--muted); background:transparent; border:1px solid var(--border); border-radius:4px; }
  .task-list :global(.is-done label span) { text-decoration:line-through; opacity:.65; }
  .clear-button { margin-top:18px; color:var(--muted); }
  .shortcut-section img { width:100%; aspect-ratio:16/10; object-fit:cover; margin-bottom:22px; }
  .shortcut-section nav { display:grid; margin-top:16px; border-top:1px solid var(--border); }
  .shortcut-section nav a { display:flex; align-items:center; justify-content:space-between; padding:15px 0; gap:12px; border-bottom:1px solid var(--border); }
  .shortcut-section nav a div { display:grid; gap:4px; }
  .shortcut-section nav a strong { font-size:16px; }
  .shortcut-section nav a small { color:var(--muted); font:12px monospace; }
  .shortcut-section nav a > span { color:var(--cyan); }
  .shortcut-section nav a:hover { color:var(--cyan); }
  @media(max-width:760px) { .workbench-layout { grid-template-columns:1fr; gap:48px; } }
</style>
